    private static readonly IReadOnlyList<SqlColumnTypeOption> MariaDbColumnTypes = MySqlColumnTypes;

    private static readonly IReadOnlyList<SqlColumnTypeOption> SqlServerColumnTypes = new List<SqlColumnTypeOption>
    {
        TypeOption("bit", "BIT · boolean", "Số/boolean"),
        TypeOption("tinyint", "TINYINT", "Số", auto: true),
        TypeOption("smallint", "SMALLINT", "Số", auto: true),
        TypeOption("int", "INT", "Số", auto: true),
