    private async Task OnImportFileChangedAsync(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;
            if (file.Size > ImportMaxFileBytes)
            {
                ImportFileStatus = $"File quá lớn ({FormatBytes(file.Size)}). Giới hạn hiện tại {FormatBytes(ImportMaxFileBytes)}.";
                StatusError(ImportFileStatus);
                return;
            }

            await using var browserStream = file.OpenReadStream(ImportMaxFileBytes);
            await using var memory = new MemoryStream();
            await browserStream.CopyToAsync(memory);
            memory.Position = 0;

            ImportText = await ReadImportScriptFromStreamAsync(file.Name, memory);
            ImportFileStatus = $"Đã nạp {file.Name} · {FormatBytes(file.Size)} · {ImportText.Length:n0} ký tự.";
            StatusOk(ImportFileStatus);
        }
        catch (Exception ex)
        {
            ImportFileStatus = "Không đọc được file import: " + ex.Message;
            StatusError(ImportFileStatus);
        }
    }

    private static async Task<string> ReadImportScriptFromStreamAsync(string fileName, Stream stream)
    {
        var lower = fileName.ToLowerInvariant();
        if (lower.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            using var archive = new System.IO.Compression.ZipArchive(stream, System.IO.Compression.ZipArchiveMode.Read, leaveOpen: true);
            var entry = archive.Entries
                .Where(x => !string.IsNullOrWhiteSpace(x.Name))
                .OrderByDescending(x => x.Name.EndsWith(".sql", StringComparison.OrdinalIgnoreCase))
                .ThenByDescending(x => x.Name.EndsWith(".txt", StringComparison.OrdinalIgnoreCase))
                .FirstOrDefault();
            if (entry is null)
            {
                throw new InvalidOperationException("Zip không có file .sql/.txt để import.");
            }

            await using var entryStream = entry.Open();
            using var reader = new StreamReader(entryStream, System.Text.Encoding.UTF8, detectEncodingFromByteOrderMarks: true, bufferSize: 1024, leaveOpen: false);
            return await reader.ReadToEndAsync();
        }

        if (lower.EndsWith(".gz", StringComparison.OrdinalIgnoreCase))
        {
            await using var gzip = new System.IO.Compression.GZipStream(stream, System.IO.Compression.CompressionMode.Decompress, leaveOpen: true);
            using var reader = new StreamReader(gzip, System.Text.Encoding.UTF8, detectEncodingFromByteOrderMarks: true, bufferSize: 1024, leaveOpen: false);
            return await reader.ReadToEndAsync();
        }

        using (var reader = new StreamReader(stream, System.Text.Encoding.UTF8, detectEncodingFromByteOrderMarks: true, bufferSize: 1024, leaveOpen: true))
        {
            return await reader.ReadToEndAsync();
        }
    }

    private async Task CopyExportAsync()
    {
        if (string.IsNullOrWhiteSpace(ExportText)) return;
        await JS.InvokeVoidAsync("configToolFiles.copyText", ExportText);
        StatusOk("Đã copy script export vào clipboard.");
