    private void InsertContextSelectQuery()
    {
        if (ContextTable is not null)
        {
            var columns = Columns.Count == 0 ? "*" : string.Join(", ", Columns.Select(c => QuoteSqlIdentifier(c.Name)));
            QueryText = $"SELECT {columns}{Environment.NewLine}FROM {FormatTableIdentifier(ContextTable)}{Environment.NewLine}{BuildDefaultLimitClause()};";
