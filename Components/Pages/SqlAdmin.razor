            PruneSelectionsToCurrentLists();
            if (SelectedTable is not null) { await LoadColumnsAsync(); await LoadIndexesAsync(); await LoadForeignKeysAsync(); await LoadTemplatesAsync(); }
        }
        catch (Exception ex) { StatusError(ex.Message); }
