    private void OnDatabaseCharsetChanged(SqlDatabaseCrudRequest db, string? charset)
    {
        db.Charset = string.IsNullOrWhiteSpace(charset) ? "utf8mb4" : charset;
        var options = GetCollationsForCharset(db.Charset);
        if (!options.Contains(db.Collation, StringComparer.OrdinalIgnoreCase)) db.Collation = options.First();
    }

    private void OnTableCharsetChanged(SqlTableCrudRequest table, string? charset)
    {
        table.Charset = string.IsNullOrWhiteSpace(charset) ? "utf8mb4" : charset;
    }

    private string GetRecordInputType(SqlColumnDto column)
    {
        var sqlType = SqlConnectConfigService.NormalizeType(SelectedProfile?.TypeConnect);
        var type = GetRecordColumnTypeName(column);
        if (sqlType == "sqlserver" && type is "timestamp" or "rowversion") return "textarea";
        if (type is "date") return "date";
        if (type is "datetimeoffset" or "timestamptz") return "textarea";
        if (type.Contains("datetime", StringComparison.Ordinal) || type.Contains("timestamp", StringComparison.Ordinal) || type is "smalldatetime") return "datetime-local";
        if (type is "time") return "time";
        return "textarea";
    }

    private string GetRecordInputHint(SqlColumnDto column)
    {
        var type = GetRecordInputType(column);
        var nullText = column.IsNullable ? "NULL cho phép" : "NOT NULL";
        var keyText = column.IsPrimaryKey ? " · Primary key" : string.Empty;
        return type switch
        {
            "date" => $"{nullText}{keyText} · Khi lưu tự chuẩn hóa SQL yyyy-MM-dd",
            "datetime-local" => $"{nullText}{keyText} · Khi lưu tự chuẩn hóa SQL yyyy-MM-dd HH:mm:ss",
            "time" => $"{nullText}{keyText} · Khi lưu tự chuẩn hóa SQL HH:mm:ss",
            _ => $"{nullText}{keyText}"
        };
    }

    private string? FormatRecordValueForInput(SqlColumnDto column, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return value;
        var inputType = GetRecordInputType(column);
        if (inputType == "datetime-local")
        {
            var normalized = NormalizeRecordSqlDateValue(column, value);
            var text = (normalized ?? value).Trim().Replace(' ', 'T');
            return text.Length >= 19 ? text[..19] : text;
        }
        if (inputType == "date")
        {
            var normalized = NormalizeRecordSqlDateValue(column, value);
            return (normalized ?? value).Trim().Length >= 10 ? (normalized ?? value).Trim()[..10] : (normalized ?? value).Trim();
        }
        if (inputType == "time")
        {
            var normalized = NormalizeRecordSqlDateValue(column, value);
            return (normalized ?? value).Trim().Length >= 8 ? (normalized ?? value).Trim()[..8] : (normalized ?? value).Trim();
        }
        return value;
    }

    private string? NormalizeRecordInputValue(SqlColumnDto column, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return value;
        return NormalizeRecordSqlDateValue(column, value);
    }

    private Dictionary<string, string?> NormalizeRecordValuesForSave(Dictionary<string, string?> values)
    {
        var normalized = new Dictionary<string, string?>(values, StringComparer.OrdinalIgnoreCase);
        foreach (var column in Columns)
        {
            if (normalized.TryGetValue(column.Name, out var value))
            {
                normalized[column.Name] = NormalizeRecordSqlDateValue(column, value);
            }
        }

        return normalized;
    }

    private string? NormalizeRecordSqlDateValue(SqlColumnDto column, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return value;
        var trimmed = value.Trim();
        if (string.Equals(trimmed, "NULL", StringComparison.OrdinalIgnoreCase) || string.Equals(trimmed, "<NULL>", StringComparison.OrdinalIgnoreCase)) return trimmed;

        var inputType = GetRecordInputType(column);
        var sqlType = SqlConnectConfigService.NormalizeType(SelectedProfile?.TypeConnect);
        var dataType = GetRecordColumnTypeName(column);
        return inputType switch
        {
            "date" => TryParseRecordDateTime(trimmed, out var dateValue) ? dateValue.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : trimmed,
            "datetime-local" => TryParseRecordDateTime(trimmed, out var dateTimeValue) ? FormatRecordDateTimeForSql(dateTimeValue, dataType, sqlType) : trimmed.Replace('T', ' '),
            "time" => TryParseRecordTime(trimmed, out var timeValue) ? FormatRecordTimeForSql(timeValue) : NormalizeTimeText(trimmed),
            _ => trimmed
        };
    }

    private static string GetRecordColumnTypeName(SqlColumnDto column)
    {
        var type = (string.IsNullOrWhiteSpace(column.DataType) ? column.FullDataType : column.DataType) ?? string.Empty;
        type = type.Trim().ToLowerInvariant();
        var paren = type.IndexOf('(', StringComparison.Ordinal);
        return (paren > 0 ? type[..paren] : type).Trim();
    }

    private static bool TryParseRecordDateTime(string text, out DateTime dateTime)
    {
        var normalized = text.Trim().Replace('T', ' ');
        var formats = new[]
        {
            "yyyy-MM-dd",
            "yyyy/MM/dd",
            "yyyy-MM-dd HH:mm",
            "yyyy-MM-dd HH:mm:ss",
            "yyyy-MM-dd HH:mm:ss.FFFFFFF",
            "yyyy/MM/dd HH:mm",
            "yyyy/MM/dd HH:mm:ss",
            "yyyy/MM/dd HH:mm:ss.FFFFFFF",
            "dd/MM/yyyy",
            "d/M/yyyy",
            "dd/MM/yyyy HH:mm",
            "d/M/yyyy H:mm",
            "dd/MM/yyyy HH:mm:ss",
            "d/M/yyyy H:mm:ss",
            "MM/dd/yyyy",
            "M/d/yyyy",
            "MM/dd/yyyy HH:mm",
            "M/d/yyyy H:mm",
            "MM/dd/yyyy HH:mm:ss",
            "M/d/yyyy H:mm:ss"
        };

        return DateTime.TryParseExact(normalized, formats, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out dateTime)
            || DateTime.TryParse(normalized, CultureInfo.InvariantCulture, DateTimeStyles.AllowWhiteSpaces, out dateTime)
            || DateTime.TryParse(normalized, CultureInfo.GetCultureInfo("vi-VN"), DateTimeStyles.AllowWhiteSpaces, out dateTime);
    }

    private static bool TryParseRecordTime(string text, out TimeSpan timeSpan)
    {
        var normalized = NormalizeTimeText(text.Trim());
        return TimeSpan.TryParse(normalized, CultureInfo.InvariantCulture, out timeSpan)
            || TimeSpan.TryParse(normalized, CultureInfo.GetCultureInfo("vi-VN"), out timeSpan);
    }

    private static string NormalizeTimeText(string text)
    {
        var trimmed = text.Trim();
        return trimmed.Count(x => x == ':') == 1 ? trimmed + ":00" : trimmed;
    }

    private static string FormatRecordDateTimeForSql(DateTime dateTime, string dataType, string sqlType)
    {
        if (dataType == "smalldatetime")
        {
            return dateTime.ToString("yyyy-MM-dd HH:mm:00", CultureInfo.InvariantCulture);
        }

        var baseText = dateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
        var fractionTicks = dateTime.Ticks % TimeSpan.TicksPerSecond;
        if (fractionTicks == 0) return baseText;

        var maxDigits = sqlType == "sqlserver" ? dataType is "datetime" ? 3 : 7 : 6;
        var fraction = fractionTicks.ToString("D7", CultureInfo.InvariantCulture)[..maxDigits].TrimEnd('0');
        return string.IsNullOrWhiteSpace(fraction) ? baseText : baseText + "." + fraction;
    }

    private static string FormatRecordTimeForSql(TimeSpan timeSpan)
    {
        var baseText = timeSpan.ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture);
        var fractionTicks = timeSpan.Ticks % TimeSpan.TicksPerSecond;
        if (fractionTicks == 0) return baseText;
        var fraction = fractionTicks.ToString("D7", CultureInfo.InvariantCulture).TrimEnd('0');
        return string.IsNullOrWhiteSpace(fraction) ? baseText : baseText + "." + fraction;
    }

