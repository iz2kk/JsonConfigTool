    private RenderFragment RenderSqlRows(List<SqlColumnDto>? columns, List<Dictionary<string, string?>>? rows) => @<div class="table-responsive ct-sql-table-wrap mt-3"><table class="table table-sm table-hover align-middle"><thead><tr>@if (columns is not null){@foreach (var column in columns){<th>@column.Name</th>}}</tr></thead><tbody>@if (rows is not null && rows.Count > 0 && columns is not null){@foreach (var row in rows){<tr>@foreach (var column in columns){<td><code>@(row.TryGetValue(column.Name, out var value) ? value : null)</code></td>}</tr>}}else{<tr><td colspan="@(columns?.Count > 0 ? columns.Count : 1)"><div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có dữ liệu.</div></td></tr>}</tbody></table></div>;

    private static SqlColumnEditDto ToEditColumn(SqlColumnDto col) => new() { OriginalName = col.Name, Name = col.Name, DataType = col.DataType, IsNullable = col.IsNullable, IsPrimaryKey = col.IsPrimaryKey, Ordinal = col.Ordinal };
    private static string BuildEndpoint(SqlConnectionProfileDto profile) => $"{profile.User}@{profile.Host}:{profile.Port}";
    private static SqlConnectionProfileDto CloneProfile(SqlConnectionProfileDto profile) => new() { Id = profile.Id, Name = profile.Name, TypeConnect = profile.TypeConnect, Host = profile.Host, Port = profile.Port, User = profile.User, Password = profile.Password, AllowNoPassword = profile.AllowNoPassword, Database = profile.Database, Encrypt = profile.Encrypt, TrustServerCertificate = profile.TrustServerCertificate, TimeoutSeconds = profile.TimeoutSeconds };
    private static string NormalizeSqlType(string? type) => SqlConnectConfigService.NormalizeType(type) switch { "mariadb" => "MariaDB", "sqlserver" => "SQL Server", _ => "MySQL" };
    private static string GetSqlTypeIcon(string? type) => SqlConnectConfigService.NormalizeType(type) switch { "sqlserver" => "fa-server", "mariadb" => "fa-dolphin", _ => "fa-database" };
    private static bool LooksLikeSelect(string sql) { var t = sql.TrimStart(); return t.StartsWith("SELECT", StringComparison.OrdinalIgnoreCase) || t.StartsWith("SHOW", StringComparison.OrdinalIgnoreCase) || t.StartsWith("WITH", StringComparison.OrdinalIgnoreCase); }
    private void ClearStatus() => StatusMessage = null;
    private void StatusOk(string message) { StatusIsError = false; StatusMessage = message; }
    private void StatusError(string message) { StatusIsError = true; StatusMessage = ToFriendlyUiError(message); }
    private static string ToFriendlyUiError(string message)
    {
        if (string.IsNullOrWhiteSpace(message)) return "Thao tác SQL không thành công.";
        if (message.Contains("Access denied", StringComparison.OrdinalIgnoreCase) || message.Contains("using password: NO", StringComparison.OrdinalIgnoreCase) || message.Contains("using password: YES", StringComparison.OrdinalIgnoreCase)) return "MySQL/MariaDB từ chối đăng nhập. Kiểm tra lại user, password, quyền host và mục Allow no password. Chi tiết: " + message;
        if (message.Contains("Failed to invoke", StringComparison.OrdinalIgnoreCase)) return "SignalR không gọi được thao tác SQL. App vẫn chạy, hãy kiểm tra cấu hình kết nối rồi thử lại. Chi tiết: " + message;
        return message;
    }

    public async ValueTask DisposeAsync()
    {
        SearchDebounce?.Cancel(); SearchDebounce?.Dispose(); SqlProfilesChangedSubscription?.Dispose(); SqlSoftErrorSubscription?.Dispose(); SqlSchemaChangedSubscription?.Dispose();
        if (Hub is not null) await Hub.DisposeAsync();
    }
}
