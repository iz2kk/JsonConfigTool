    private async Task PasteContextBlockAsync()
    {
        CloseSqlContextMenu();
        if (ClipboardKind == "table" && ClipboardTable is not null)
        {
            TableModalMode = "create";
            TableModalTitle = "Paste / tạo bảng từ clipboard";
            TableForm = ClipboardTable;
            TableForm.TableName = string.IsNullOrWhiteSpace(TableForm.NewTableName) ? TableForm.TableName + "_copy" : TableForm.NewTableName;
            TableForm.DatabaseName = SelectedDatabase ?? TableForm.DatabaseName;
            ShowTableModal = true;
            return;
        }
        if (ClipboardKind == "column" && ClipboardColumn is not null)
        {
            ColumnModalMode = "add";
            ColumnModalTitle = "Paste / thêm cột từ clipboard";
            ColumnForm = new SqlColumnEditDto
            {
                Name = ClipboardColumn.Name + "_copy",
                DataType = ClipboardColumn.DataType,
                Length = ClipboardColumn.Length,
                IsNullable = ClipboardColumn.IsNullable,
                IsPrimaryKey = false,
                AutoIncrement = false,
                DefaultValue = ClipboardColumn.DefaultValue,
                Extra = ClipboardColumn.Extra,
                Comment = ClipboardColumn.Comment
            };
            ShowColumnModal = true;
            return;
        }
        if (ClipboardKind == "index" && ClipboardIndex is not null)
        {
            IndexModalMode = "add";
            IndexModalTitle = "Paste / tạo key/index từ clipboard";
            IndexForm = ClipboardIndex;
            IndexForm.OriginalName = string.Empty;
            IndexForm.Name = IndexForm.Name + "_copy";
            ShowIndexModal = true;
            return;
        }
        if (ClipboardKind == "foreign" && ClipboardForeignKey is not null)
        {
            ForeignKeyModalMode = "add";
            ForeignKeyModalTitle = "Paste / tạo khóa ngoại từ clipboard";
            ForeignKeyForm = ClipboardForeignKey;
            ForeignKeyForm.OriginalConstraintName = string.Empty;
            ForeignKeyForm.ConstraintName = ForeignKeyForm.ConstraintName + "_copy";
            ShowForeignKeyModal = true;
            return;
        }
        if (ClipboardKind == "record" && ClipboardRecord is not null)
        {
            RecordModalMode = "insert";
            RecordModalTitle = "Paste / thêm record từ clipboard";
            RecordOriginal = new(StringComparer.OrdinalIgnoreCase);
            RecordValues = new Dictionary<string, string?>(ClipboardRecord, StringComparer.OrdinalIgnoreCase);
            ShowRecordModal = true;
            return;
        }
        await Task.CompletedTask;
        StatusError("Clipboard nội bộ chưa có block phù hợp để paste.");
    }

    private string FormatSqlLiteral(string? value)
    {
        if (value is null) return "NULL";
        if (string.Equals(value, "NULL", StringComparison.OrdinalIgnoreCase)) return "NULL";
        if (decimal.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal _)) return value;
        return "'" + value.Replace("'", "''", StringComparison.Ordinal) + "'";
    }

