    private void ExportDesignerOverview()
    {
        if (Designer is null) return;
        var lines = new List<string> { $"-- Designer overview: {Designer.DatabaseName}", $"-- Tables: {Designer.Tables.Count}; Relations: {Designer.Relations.Count}" };
        lines.AddRange(Designer.Tables.Select(t => $"-- TABLE {t.FullName}: {string.Join(", ", t.Columns.Select(c => c.Name))}"));
        lines.AddRange(Designer.Relations.Select(r => $"-- FK {r.ConstraintName}: {r.FromTable}.{r.FromColumn} -> {r.ToTable}.{r.ToColumn} UPDATE {r.UpdateRule} DELETE {r.DeleteRule}"));
        QueryText = string.Join(Environment.NewLine, lines);
        SqlTab = "query";
        StatusOk("Đã export designer overview vào query editor.");
    }

