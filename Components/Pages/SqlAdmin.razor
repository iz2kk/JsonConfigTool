    private RenderFragment RenderMaintenanceResultTable() => builder =>
    {
        if (MaintenanceResult?.Rows is not { Count: > 0 }) return;
        var seq = 0;
        builder.OpenElement(seq++, "div"); builder.AddAttribute(seq++, "class", "table-responsive ct-sql-table-wrap");
        builder.OpenElement(seq++, "table"); builder.AddAttribute(seq++, "class", "table table-sm table-hover align-middle");
        builder.OpenElement(seq++, "thead"); builder.OpenElement(seq++, "tr");
        foreach (var col in MaintenanceResult.Columns)
        {
            builder.OpenElement(seq++, "th"); builder.AddContent(seq++, col.Name); builder.CloseElement();
        }
        builder.CloseElement(); builder.CloseElement();
        builder.OpenElement(seq++, "tbody");
        foreach (var row in MaintenanceResult.Rows)
        {
            builder.OpenElement(seq++, "tr");
            foreach (var col in MaintenanceResult.Columns)
            {
                builder.OpenElement(seq++, "td"); builder.AddContent(seq++, row.TryGetValue(col.Name, out var value) ? value : string.Empty); builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement(); builder.CloseElement(); builder.CloseElement();
    };

