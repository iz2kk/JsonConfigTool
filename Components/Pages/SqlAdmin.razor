    private async Task DownloadExportAsync()
    {
        if (string.IsNullOrWhiteSpace(ExportText)) return;
        var fileName = BuildExportFileName();
        await JS.InvokeVoidAsync("configToolFiles.downloadTextFile", fileName, ExportText, "application/sql;charset=utf-8");
        StatusOk("Đã tạo file tải xuống: " + fileName);
    }

    private string BuildExportFileName()
    {
        var db = SanitizeFileName(SelectedDatabase ?? "database");
        var suffix = ExportScope == "table" && SelectedTable is not null
            ? "_" + SanitizeFileName(SelectedTable.Name)
            : ExportScope == "selectedRows" && SelectedTable is not null
                ? "_" + SanitizeFileName(SelectedTable.Name) + "_selected_rows"
                : "_full";
        return $"{db}{suffix}_{DateTime.Now:yyyyMMdd_HHmmss}.sql";
    }

    private static string SanitizeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(value.Select(ch => invalid.Contains(ch) ? '_' : ch).ToArray());
        return string.IsNullOrWhiteSpace(cleaned) ? "export" : cleaned;
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double value = bytes;
        var index = 0;
        while (value >= 1024 && index < units.Length - 1)
        {
            value /= 1024;
            index++;
        }
        return $"{value:0.##} {units[index]}";
    }

    private void ClearImportText()
    {
        ImportText = string.Empty;
        ImportFileStatus = "Đã xóa nội dung import.";
    }

    private async Task RunQueryAsync()
    {
        if (Hub is null || SelectedProfile is null) return;
        Busy = true;
        try
        {
            var request = new SqlQueryRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase ?? EditingProfile?.Database ?? string.Empty, QueryText = QueryText, MaxRows = QueryMaxRows };
            QueryResult = await Hub.InvokeAsync<SqlQueryResultDto>("ExecuteSqlQueryAsync", request);
            BuildQueryEditableRowsFromResult();
            if (QueryResult.Success) StatusOk(QueryResult.Message); else StatusError(QueryResult.Message);
            if (QueryResult.Success && !LooksLikeSelect(QueryText)) await ReloadSelectedSqlAsync();
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private async Task RunExportAsync()
    {
        if (Hub is null || SelectedProfile is null || string.IsNullOrWhiteSpace(SelectedDatabase) || !CanRunExport) return;
        Busy = true;
        try
        {
            var scope = ExportScope;
            var table = scope is "table" or "selectedRows" ? SelectedTable : null;
            var result = await Hub.InvokeAsync<SqlQueryResultDto>("ExportSqlScriptAsync", new SqlExportRequest
            {
                ProfileId = SelectedProfile.Id,
                DatabaseName = SelectedDatabase,
                Schema = table?.Schema ?? string.Empty,
                TableName = table?.Name ?? string.Empty,
                Scope = scope,
                Format = "sql",
