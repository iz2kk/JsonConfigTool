    private string FormatTableIdentifier(SqlTableDto table)
    {
        var isSqlServer = IsSelectedSqlServer();
        if (isSqlServer && !string.IsNullOrWhiteSpace(table.Schema)) return $"{QuoteSqlIdentifier(table.Schema)}.{QuoteSqlIdentifier(table.Name)}";
        return QuoteSqlIdentifier(table.Name);
    }

    private string QuoteSqlIdentifier(string identifier)
    {
        if (string.IsNullOrWhiteSpace(identifier)) return identifier;
        return IsSelectedSqlServer()
            ? "[" + identifier.Replace("]", "]]", StringComparison.Ordinal) + "]"
            : "`" + identifier.Replace("`", "``", StringComparison.Ordinal) + "`";
    }

    private bool IsSelectedSqlServer() => SqlConnectConfigService.NormalizeType(SelectedProfile?.TypeConnect ?? EditingProfile?.TypeConnect) == "sqlserver";

    private string BuildDefaultLimitClause() => IsSelectedSqlServer() ? string.Empty : $"LIMIT {Math.Clamp(QueryMaxRows, 1, 5000)}";

