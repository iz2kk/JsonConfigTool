            <label class="form-label"><i class="fa-duotone fa-solid fa-table"></i> Bảng tham chiếu</label>
            <select class="form-select" value="@ForeignKeyForm.ReferencedTableName" @onchange="OnForeignReferenceTableChanged">
                @foreach (var table in Tables.Where(t => string.Equals(t.Type, "BASE TABLE", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(t.Type)))
                {
                    <option value="@table.Name">@table.FullName</option>
                }
            </select>
        </div>
        <div class="ct-form-block">
            <label class="form-label"><i class="fa-duotone fa-solid fa-key"></i> Cột tham chiếu</label>
            <input class="form-control" list="sqlReferenceColumnList" @bind="ForeignKeyForm.ReferencedColumnName" placeholder="id" />
            <datalist id="sqlReferenceColumnList">
                @foreach (var c in Columns)
                {
                    <option value="@c.Name"></option>
                }
            </datalist>
            <div class="ct-muted small mt-1">Chọn nhanh từ cột bảng hiện tại hoặc nhập cột của bảng tham chiếu.</div>
        </div>
        <div class="ct-form-block">
            <label class="form-label"><i class="fa-duotone fa-solid fa-rotate"></i> ON UPDATE</label>
            <select class="form-select" @bind="ForeignKeyForm.UpdateRule">
                @foreach (var rule in ForeignKeyRules())
                {
                    <option value="@rule">@rule</option>
                }
            </select>
        </div>
        <div class="ct-form-block">
            <label class="form-label"><i class="fa-duotone fa-solid fa-trash-can"></i> ON DELETE</label>
            <select class="form-select" @bind="ForeignKeyForm.DeleteRule">
                @foreach (var rule in ForeignKeyRules())
                {
                    <option value="@rule">@rule</option>
                }
            </select>
        </div>
        <div class="ct-form-block is-wide">
            <div class="ct-sql-fk-rule-row">
                <span class="badge text-bg-light border"><i class="fa-duotone fa-solid fa-table"></i> @($"{SelectedTable?.Name}.{ForeignKeyForm.ColumnName}")</span>
                <i class="fa-duotone fa-solid fa-arrow-right-long"></i>
                <span class="badge text-bg-light border"><i class="fa-duotone fa-solid fa-table"></i> @($"{ForeignKeyForm.ReferencedTableName}.{ForeignKeyForm.ReferencedColumnName}")</span>
            </div>
            <div class="ct-muted small mt-2">Sửa foreign key sẽ drop constraint cũ rồi tạo lại constraint mới, giống cách MySQL/MariaDB thường xử lý.</div>
        </div>
    </div>;

    private static string[] ForeignKeyRules() => ["NO ACTION", "RESTRICT", "CASCADE", "SET NULL", "SET DEFAULT"];

    private void OnForeignReferenceTableChanged(ChangeEventArgs args)
    {
        ForeignKeyForm.ReferencedTableName = args.Value?.ToString() ?? string.Empty;
        var table = Tables.FirstOrDefault(t => string.Equals(t.Name, ForeignKeyForm.ReferencedTableName, StringComparison.OrdinalIgnoreCase));
        ForeignKeyForm.ReferencedSchema = table?.Schema ?? SelectedTable?.Schema ?? string.Empty;
        if (string.IsNullOrWhiteSpace(ForeignKeyForm.ReferencedColumnName))
        {
            ForeignKeyForm.ReferencedColumnName = "id";
        }
    }

