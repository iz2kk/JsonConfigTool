    private async Task SaveDatabaseAsync()
    {
        if (Hub is null || SelectedProfile is null) return;
        Busy = true;
        try
        {
            if (DatabaseModalMode == "bulk-create")
            {
                var ok = 0;
                var errors = new List<string>();
                foreach (var form in BulkDatabaseForms.Where(x => !string.IsNullOrWhiteSpace(x.DatabaseName)))
                {
                    form.ProfileId = SelectedProfile.Id;
                    var result = await Hub.InvokeAsync<SqlActionResultDto>("CreateSqlDatabaseAsync", form);
                    if (result.Success) ok++; else errors.Add(form.DatabaseName + ": " + result.Message);
                }

                if (errors.Count == 0) { StatusOk($"Đã tạo {ok} database."); CloseModals(); await LoadDatabasesAsync(); }
                else StatusError($"Tạo được {ok} database, lỗi {errors.Count}: " + string.Join(" | ", errors.Take(5)));
                return;
            }

            DatabaseForm.ProfileId = SelectedProfile.Id;
            var method = DatabaseModalMode == "rename" ? "RenameSqlDatabaseAsync" : DatabaseModalMode == "drop" ? "DropSqlDatabaseAsync" : "CreateSqlDatabaseAsync";
            var single = await Hub.InvokeAsync<SqlActionResultDto>(method, DatabaseForm);
            if (single.Success) { StatusOk(single.Message); CloseModals(); await LoadDatabasesAsync(); } else StatusError(single.Message);
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

