        try { Columns = await Hub.InvokeAsync<List<SqlColumnDto>>("GetSqlColumnsAsync", SelectedProfile.Id, SelectedDatabase, SelectedTable.Schema, SelectedTable.Name); PruneSelectionsToCurrentLists(); }
        catch (Exception ex) { StatusError(ex.Message); }
    }

    private async Task LoadIndexesAsync()
