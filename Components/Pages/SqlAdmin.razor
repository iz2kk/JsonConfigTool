@if (ShowRecordModal)
{
    <div class="modal fade show ct-modal" tabindex="-1" style="display:block;" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-xl modal-dialog-centered ct-sql-modal-dialog">
            <div class="modal-content border-0 shadow-lg ct-resizable-modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-duotone fa-solid fa-cube"></i> @RecordModalTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    @if (RecordModalMode == "delete")
                    {
                        <div class="alert alert-warning"><i class="fa-duotone fa-solid fa-triangle-exclamation"></i> Xóa record này?</div>
                    }
                    @if (RecordModalMode == "bulk-insert")
                    {
                        <div class="ct-pane-head mb-2">
                            <strong><i class="fa-duotone fa-solid fa-layer-plus"></i> Bulk create record</strong>
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddBulkRecordBlock"><i class="fa-duotone fa-solid fa-plus"></i> Thêm record</button>
                        </div>
                        <div class="ct-sql-block-list">
                            @for (var i = 0; i < BulkRecordRows.Count; i++)
                            {
                                var rowIndex = i;
                                <div class="ct-sql-block" @key="BulkRecordRows[rowIndex]">
                                    <div class="ct-sql-block-head">
                                        <strong><i class="fa-duotone fa-solid fa-cube"></i> Record #@(rowIndex + 1)</strong>
                                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveBulkRecordBlock(rowIndex)"><i class="fa-duotone fa-solid fa-minus"></i></button>
                                    </div>
                                    <div class="ct-sql-record-editor-grid">
                                        @foreach (var column in Columns)
                                        {
                                            <div class="ct-sql-record-edit-block" @key="column.Name">
                                                <label class="form-label"><i class="fa-duotone fa-solid @(column.IsPrimaryKey ? "fa-key" : "fa-input-text")"></i> @column.Name <span class="badge text-bg-light border">@column.DataType</span></label>
                                                @RenderRecordInput(BulkRecordRows[rowIndex], column, false)
                                                <div class="ct-muted small">@GetRecordInputHint(column)</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ct-sql-record-editor-grid">
                            @foreach (var column in Columns)
                            {
                                <div class="ct-sql-record-edit-block" @key="column.Name">
                                    <label class="form-label"><i class="fa-duotone fa-solid @(column.IsPrimaryKey ? "fa-key" : "fa-input-text")"></i> @column.Name <span class="badge text-bg-light border">@column.DataType</span></label>
                                    @RenderRecordInput(RecordValues, column, RecordModalMode == "delete")
                                    <div class="ct-muted small">@GetRecordInputHint(column)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseModals">Hủy</button>
                    <button class="btn btn-primary" disabled="@Busy" @onclick="SaveRecordAsync"><i class="fa-duotone fa-solid fa-floppy-disk"></i> Thực hiện</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

