    private async Task LoadRecordsAsync()
    {
        if (Hub is null || SelectedProfile is null || SelectedTable is null || string.IsNullOrWhiteSpace(SelectedDatabase)) return;
        Busy = true;
        try
        {
            var request = new SqlRecordQueryRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable.Schema, TableName = SelectedTable.Name, Search = RecordSearch, Page = RecordPageNumber, PageSize = RecordPageSize };
            RecordPage = await Hub.InvokeAsync<SqlRowPageDto>("QuerySqlRecordsAsync", request);
            RecordPageNumber = RecordPage.Page;
            PruneSelectedRecordsToCurrentTable();
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private bool AreAllDatabasesSelected => Databases.Count > 0 && Databases.All(db => SelectedDatabaseNames.Contains(db.Name));
    private bool AreAllTablesSelected => Tables.Count > 0 && Tables.All(IsTableSelected);
    private bool AreAllColumnsSelected => Columns.Count > 0 && Columns.All(c => SelectedColumnNames.Contains(c.Name));
    private bool AreAllCurrentRecordsSelected => RecordPage?.Rows?.Count > 0 && RecordPage.Rows.All(IsRecordSelected);

    private bool IsDatabaseSelected(string databaseName) => SelectedDatabaseNames.Contains(databaseName);

    private void ToggleDatabaseSelection(string databaseName, object? value)
    {
        if (value is bool b && b) SelectedDatabaseNames.Add(databaseName);
        else SelectedDatabaseNames.Remove(databaseName);
    }

    private void ToggleAllDatabases(object? value)
    {
        if (value is bool b && b)
        {
            foreach (var db in Databases) SelectedDatabaseNames.Add(db.Name);
        }
        else
        {
            foreach (var db in Databases) SelectedDatabaseNames.Remove(db.Name);
        }
    }

    private string BuildTableSelectionKey(SqlTableDto table) => string.IsNullOrWhiteSpace(table.Schema) ? table.Name : table.Schema + "." + table.Name;
    private bool IsTableSelected(SqlTableDto table) => SelectedTableKeys.Contains(BuildTableSelectionKey(table));

    private void ToggleTableSelection(SqlTableDto table, object? value)
    {
        var key = BuildTableSelectionKey(table);
        if (value is bool b && b) SelectedTableKeys.Add(key);
        else SelectedTableKeys.Remove(key);
    }

    private void ToggleAllTables(object? value)
    {
        if (value is bool b && b)
        {
            foreach (var table in Tables) SelectedTableKeys.Add(BuildTableSelectionKey(table));
        }
        else
        {
            foreach (var table in Tables) SelectedTableKeys.Remove(BuildTableSelectionKey(table));
        }
    }

    private bool IsColumnSelected(string columnName) => SelectedColumnNames.Contains(columnName);

    private void ToggleColumnSelection(string columnName, object? value)
    {
        if (value is bool b && b) SelectedColumnNames.Add(columnName);
        else SelectedColumnNames.Remove(columnName);
    }

    private void ToggleAllColumns(object? value)
    {
        if (value is bool b && b)
        {
            foreach (var column in Columns) SelectedColumnNames.Add(column.Name);
        }
        else
        {
            foreach (var column in Columns) SelectedColumnNames.Remove(column.Name);
        }
    }

    private void ToggleAllCurrentRecords(object? value)
    {
        if (RecordPage?.Rows is null) return;
        if (value is bool b && b)
        {
            foreach (var row in RecordPage.Rows)
            {
                var key = BuildRecordSelectionKey(row);
                SelectedRecordKeys.Add(key);
                SelectedRecordRows[key] = new Dictionary<string, string?>(row, StringComparer.OrdinalIgnoreCase);
            }
        }
        else
        {
            foreach (var row in RecordPage.Rows)
            {
                var key = BuildRecordSelectionKey(row);
                SelectedRecordKeys.Remove(key);
                SelectedRecordRows.Remove(key);
            }
        }
    }

    private void PruneSelectionsToCurrentLists()
    {
        SelectedDatabaseNames.RemoveWhere(db => Databases.All(x => !string.Equals(x.Name, db, StringComparison.OrdinalIgnoreCase)));
        SelectedTableKeys.RemoveWhere(key => Tables.All(x => !string.Equals(BuildTableSelectionKey(x), key, StringComparison.OrdinalIgnoreCase)));
        SelectedColumnNames.RemoveWhere(name => Columns.All(x => !string.Equals(x.Name, name, StringComparison.OrdinalIgnoreCase)));
    }

