                            {
                                <td class="ct-sticky-action-col">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-success" disabled="@Busy" @onclick="() => SaveQueryResultRowAsync(rowIndex)"><i class="fa-duotone fa-solid fa-floppy-disk"></i></button>
                                        <button type="button" class="btn btn-outline-danger" disabled="@Busy" @onclick="() => DeleteQueryResultRowAsync(rowIndex)"><i class="fa-duotone fa-solid fa-trash-can"></i></button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
