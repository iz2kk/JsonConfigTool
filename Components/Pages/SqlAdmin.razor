@using System.Globalization
@page "/sql"
@implements IAsyncDisposable
@inject ConfigSignalRHost SignalRHost
@inject ILocalExplorerService Explorer
@inject IJSRuntime JS

<PageTitle>SQL Admin</PageTitle>

<div class="ct-page ct-sql-page">
    <section class="ct-hero card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="ct-eyebrow"><i class="fa-duotone fa-solid fa-database"></i> SQL / MySQL / MariaDB / MSSQL</div>
                    <h1 class="ct-title mb-2">SQL Admin </h1>
                    <p class="ct-muted mb-0">Connect lưu ở <code>@ConnectFilePath</code>, chạy qua SignalR local server.</p>
                </div>
                <div class="ct-status-pill @(IsConnected ? "is-online" : "is-offline")">
                    <i class="fa-duotone fa-solid @(IsConnected ? "fa-circle-check" : "fa-plug-circle-xmark")"></i>
                    @(IsConnected ? "SignalR đã kết nối" : "SignalR chưa kết nối")
                </div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert @(StatusIsError ? "alert-danger" : "alert-success") ct-alert shadow-sm" role="alert">
            <i class="fa-duotone fa-solid @(StatusIsError ? "fa-triangle-exclamation" : "fa-circle-info")"></i>
            <span>@StatusMessage</span>
            <button type="button" class="btn-close ms-auto" aria-label="Close" @onclick="ClearStatus"></button>
        </div>
    }

    <section class="card border-0 shadow-sm ct-panel ct-sql-accounts-panel">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div>
                    <h2 class="ct-section-title mb-1"><i class="fa-duotone fa-solid fa-plug-circle-bolt"></i> Multi tài khoản SQL</h2>
                    <div class="ct-muted small">Danh sách tài khoản full width. Form thêm/sửa/xóa mở bằng modal để không chiếm màn hình quản trị.</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="() => LoadProfilesAsync(true)"><i class="fa-duotone fa-solid fa-rotate"></i> Tải lại</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@Busy" @onclick="OpenSqlConfigFolderAsync"><i class="fa-duotone fa-solid fa-folder-open"></i> Open config folder SQL</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="NewProfile"><i class="fa-duotone fa-solid fa-plus"></i> Thêm tài khoản</button>
                </div>
            </div>

            <div class="ct-sql-account-toolbar mb-3">
                <div class="ct-sql-account-picker">
                    <label class="ct-muted small mb-1 d-block">Tài khoản đang dùng</label>
                    <select class="form-select" value="@(SelectedProfile?.Id ?? string.Empty)" @onchange="OnProfileSelectChangedAsync">
                        @foreach (var profile in Profiles)
                        {
                            <option value="@profile.Id">@NormalizeSqlType(profile.TypeConnect) · @profile.Name · @BuildEndpoint(profile)</option>
                        }
                    </select>
                </div>
                <div class="ct-sql-account-summary">
                    @if (SelectedProfile is null)
                    {
                        <span><i class="fa-duotone fa-solid fa-circle-info"></i> Chưa chọn tài khoản SQL.</span>
                    }
                    else
                    {
                        <span><i class="fa-duotone fa-solid @GetSqlTypeIcon(SelectedProfile.TypeConnect)"></i> @NormalizeSqlType(SelectedProfile.TypeConnect)</span>
                        <span><i class="fa-duotone fa-solid fa-network-wired"></i> @BuildEndpoint(SelectedProfile)</span>
                        <span><i class="fa-duotone fa-solid fa-database"></i> @(string.IsNullOrWhiteSpace(SelectedProfile.Database) ? "chưa chọn DB" : SelectedProfile.Database)</span>
                    }
                </div>
            </div>

            <div class="ct-sql-profile-list is-multi-account is-full-width">
                @if (Profiles.Count == 0)
                {
                    <div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có tài khoản SQL nào trong connect.json.</div>
                }
                @foreach (var profile in Profiles)
                {
                    <div class="ct-sql-profile-card @(SelectedProfile?.Id == profile.Id ? "active" : null)" @key="profile.Id">
                        <button type="button" class="ct-sql-card-main" @onclick="() => SelectProfileAsync(profile)">
                            <span class="d-flex align-items-center justify-content-between gap-2">
                                <strong><i class="fa-duotone fa-solid @GetSqlTypeIcon(profile.TypeConnect)"></i> @profile.Name</strong>
                                <span class="badge text-bg-light border">@NormalizeSqlType(profile.TypeConnect)</span>
                            </span>
                            <span class="small mt-1 d-block">@BuildEndpoint(profile)</span>
                            <span class="small text-truncate d-block">DB: @(string.IsNullOrWhiteSpace(profile.Database) ? "chưa chọn" : profile.Database)</span>
                        </button>
                        <div class="ct-sql-profile-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary ct-profile-primary-action" @onclick="() => SelectProfileAsync(profile)"><i class="fa-duotone fa-solid fa-circle-check"></i> Chọn</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditProfile(profile)"><i class="fa-duotone fa-solid fa-pen"></i> Sửa</button>
                            <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => DuplicateProfile(profile)"><i class="fa-duotone fa-solid fa-copy"></i> Nhân bản</button>
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => TestProfileAsync(profile.Id)"><i class="fa-duotone fa-solid fa-signal-stream"></i> Test</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteProfile(profile)"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm ct-panel">
        <div class="card-body p-3 p-lg-4">
            <ul class="nav nav-pills ct-sql-tabs mb-3" role="tablist">
                <li class="nav-item"><button type="button" class="nav-link @(SqlTab == "browser" ? "active" : null)" @onclick='() => SetSqlTab("browser")'><i class="fa-duotone fa-solid fa-table-tree"></i> Database / Bảng / Cột</button></li>
                <li class="nav-item"><button type="button" class="nav-link @(SqlTab == "records" ? "active" : null)" @onclick='() => SetSqlTab("records")'><i class="fa-duotone fa-solid fa-table-list"></i> CRUD record</button></li>
                <li class="nav-item"><button type="button" class="nav-link @(SqlTab == "query" ? "active" : null)" @onclick='() => SetSqlTab("query")'><i class="fa-duotone fa-solid fa-terminal"></i> Query</button></li>
                <li class="nav-item"><button type="button" class="nav-link @(SqlTab == "importexport" ? "active" : null)" @onclick='() => SetSqlTab("importexport")'><i class="fa-duotone fa-solid fa-file-export"></i> Import / Export</button></li>
                <li class="nav-item"><button type="button" class="nav-link @(SqlTab == "maintenance" ? "active" : null)" @onclick='() => SetSqlTab("maintenance")'><i class="fa-duotone fa-solid fa-screwdriver-wrench"></i> Maintenance</button></li>
                <li class="nav-item"><button type="button" class="nav-link @(SqlTab == "designer" ? "active" : null)" @onclick='() => SetSqlTab("designer")'><i class="fa-duotone fa-solid fa-diagram-project"></i> Designer</button></li>
            </ul>

            @if (SqlTab == "browser")
            {
                <div class="ct-sql-server-dashboard mb-3">
                    <div class="ct-sql-server-card">
                        <span class="ct-muted small"><i class="fa-duotone fa-solid fa-server"></i> Server</span>
                        <strong>@(ServerInfo?.Version ?? "chưa tải")</strong>
                    </div>
                    <div class="ct-sql-server-card">
                        <span class="ct-muted small"><i class="fa-duotone fa-solid fa-database"></i> Database</span>
                        <strong>@(ServerInfo?.DatabaseCount ?? Databases.Count)</strong>
                    </div>
                    <div class="ct-sql-server-card">
                        <span class="ct-muted small"><i class="fa-duotone fa-solid fa-language"></i> Charset / Collation</span>
                        <strong>@(string.IsNullOrWhiteSpace(ServerInfo?.Charset) ? ServerInfo?.Collation : $"{ServerInfo?.Charset} · {ServerInfo?.Collation}")</strong>
                    </div>
                    <div class="ct-sql-server-card">
                        <span class="ct-muted small"><i class="fa-duotone fa-solid fa-clock"></i> Uptime</span>
                        <strong>@(string.IsNullOrWhiteSpace(ServerInfo?.Uptime) ? "n/a" : ServerInfo?.Uptime)</strong>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Busy || SelectedProfile is null)" @onclick="LoadServerInfoAsync"><i class="fa-duotone fa-solid fa-rotate"></i> Refresh info</button>
                </div>

                <div class="ct-sql-browser-toolbar mb-3">
                    <button class="btn btn-primary" type="button" title="Tạo 1 database" disabled="@(Busy || SelectedProfile is null)" @onclick="OpenCreateDatabase"><i class="fa-duotone fa-solid fa-database-circle-plus"></i> Tạo database</button>
                    <button class="btn btn-outline-primary" type="button" title="Tạo nhiều database cùng lúc" disabled="@(Busy || SelectedProfile is null)" @onclick="OpenBulkCreateDatabases"><i class="fa-duotone fa-solid fa-layer-plus"></i> Bulk DB</button>
                    <button class="btn btn-outline-secondary" type="button" title="Sửa/đổi tên database đang chọn" disabled="@(Busy || string.IsNullOrWhiteSpace(SelectedDatabase))" @onclick="OpenRenameDatabase"><i class="fa-duotone fa-solid fa-pen-to-square"></i> Sửa database</button>
                    <button class="btn btn-outline-danger" type="button" title="Xóa database đang chọn" disabled="@(Busy || string.IsNullOrWhiteSpace(SelectedDatabase))" @onclick="OpenDropDatabase"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa database</button>
                    <button class="btn btn-outline-danger" type="button" title="Xóa toàn bộ database đã tick" disabled="@(Busy || SelectedDatabaseNames.Count == 0)" @onclick="BulkDropSelectedDatabasesAsync"><i class="fa-duotone fa-solid fa-trash-list"></i> Xóa DB đã tick (@SelectedDatabaseNames.Count)</button>
                    <button class="btn btn-success" type="button" title="Tạo 1 bảng" disabled="@(Busy || string.IsNullOrWhiteSpace(SelectedDatabase))" @onclick="OpenCreateTable"><i class="fa-duotone fa-solid fa-table-circle-plus"></i> Tạo bảng</button>
                    <button class="btn btn-outline-success" type="button" title="Tạo nhiều bảng cùng lúc" disabled="@(Busy || string.IsNullOrWhiteSpace(SelectedDatabase))" @onclick="OpenBulkCreateTables"><i class="fa-duotone fa-solid fa-layer-plus"></i> Bulk bảng</button>
                    <button class="btn btn-outline-secondary" type="button" title="Sửa/đổi tên bảng đang chọn" disabled="@(Busy || SelectedTable is null)" @onclick="OpenRenameTable"><i class="fa-duotone fa-solid fa-table-cells"></i> Sửa bảng</button>
                    <button class="btn btn-outline-danger" type="button" title="Xóa bảng đang chọn" disabled="@(Busy || SelectedTable is null)" @onclick="OpenDropTable"><i class="fa-duotone fa-solid fa-table-cells-large"></i> Xóa bảng</button>
                    <button class="btn btn-outline-warning" type="button" title="TRUNCATE toàn bộ bảng đã tick" disabled="@(Busy || SelectedTableKeys.Count == 0)" @onclick="BulkTruncateSelectedTablesAsync"><i class="fa-duotone fa-solid fa-broom"></i> Empty bảng tick (@SelectedTableKeys.Count)</button>
                    <button class="btn btn-outline-danger" type="button" title="DROP toàn bộ bảng đã tick" disabled="@(Busy || SelectedTableKeys.Count == 0)" @onclick="BulkDropSelectedTablesAsync"><i class="fa-duotone fa-solid fa-trash-list"></i> Xóa bảng tick (@SelectedTableKeys.Count)</button>
                </div>

                <div class="ct-sql-browser-grid">
                    <div class="ct-sql-browser-pane">
                        <div class="ct-pane-head is-searchable">
                            <strong><i class="fa-duotone fa-solid fa-database"></i> Databases</strong>
                            <label class="ct-select-all-label" title="Tick/bỏ tick toàn bộ database đang hiển thị"><input class="form-check-input" type="checkbox" checked="@AreAllDatabasesSelected" @onchange="args => ToggleAllDatabases(args.Value)" /> all</label>
                            <input class="form-control form-control-sm" placeholder="Tìm database..." value="@DatabaseSearch" @oninput="OnDatabaseSearchInputAsync" />
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Tải lại database" disabled="@(Busy || SelectedProfile is null)" @onclick="LoadDatabasesAsync"><i class="fa-duotone fa-solid fa-rotate"></i></button>
                        </div>
                        <div class="ct-sql-list-scroll">
                            @foreach (var db in Databases)
                            {
                                <div class="ct-sql-selectable-item @(SelectedDatabase == db.Name ? "active" : null)" @key="db.Name" @oncontextmenu:preventDefault="true" @oncontextmenu="args => OpenDatabaseContextMenu(args, db.Name)" title="Click chọn database, chuột phải mở menu nhanh">
                                    <input class="form-check-input" type="checkbox" checked="@IsDatabaseSelected(db.Name)" @onchange="args => ToggleDatabaseSelection(db.Name, args.Value)" @onclick:stopPropagation="true" />
                                    <button type="button" class="ct-sql-list-item" @onclick="() => SelectDatabaseAsync(db.Name)"><span><i class="fa-duotone fa-solid fa-database"></i> @db.Name</span><small>@(string.IsNullOrWhiteSpace(db.Collation) ? db.Charset : db.Collation)</small></button>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="ct-sql-browser-pane">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-table"></i> Bảng / view</strong>
                            <label class="ct-select-all-label" title="Tick/bỏ tick toàn bộ bảng đang hiển thị"><input class="form-check-input" type="checkbox" checked="@AreAllTablesSelected" @onchange="args => ToggleAllTables(args.Value)" /> all</label>
                            <input class="form-control form-control-sm" placeholder="Tìm bảng..." value="@TableSearch" @oninput="OnTableSearchInputAsync" />
                        </div>
                        <div class="ct-sql-list-scroll">
                            @foreach (var table in Tables)
                            {
                                <div class="ct-sql-selectable-item @(SelectedTable?.FullName == table.FullName ? "active" : null)" @key="BuildTableSelectionKey(table)" @oncontextmenu:preventDefault="true" @oncontextmenu="args => OpenTableContextMenu(args, table)" title="Click chọn bảng, chuột phải mở menu nhanh">
                                    <input class="form-check-input" type="checkbox" checked="@IsTableSelected(table)" @onchange="args => ToggleTableSelection(table, args.Value)" @onclick:stopPropagation="true" />
                                    <button type="button" class="ct-sql-list-item" @onclick="() => SelectTableAsync(table)"><span><i class="fa-duotone fa-solid fa-table"></i> @table.FullName</span><small>@table.Type · @(table.RowCount?.ToString() ?? "?") rows @(string.IsNullOrWhiteSpace(table.Engine) ? string.Empty : "· " + table.Engine)</small></button>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="ct-sql-browser-pane is-wide">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-columns-3"></i> Cột dạng block</strong>
                            <label class="ct-select-all-label" title="Tick/bỏ tick toàn bộ cột"><input class="form-check-input" type="checkbox" checked="@AreAllColumnsSelected" @onchange="args => ToggleAllColumns(args.Value)" /> all</label>
                            <button class="btn btn-sm btn-primary" type="button" title="Thêm 1 cột" disabled="@(Busy || SelectedTable is null)" @onclick="OpenAddColumn"><i class="fa-duotone fa-solid fa-plus"></i> Thêm cột</button>
                            <button class="btn btn-sm btn-outline-primary" type="button" title="Thêm nhiều cột cùng lúc" disabled="@(Busy || SelectedTable is null)" @onclick="OpenBulkAddColumns"><i class="fa-duotone fa-solid fa-layer-plus"></i> Bulk cột</button>
                            <button class="btn btn-sm btn-outline-danger" type="button" title="Xóa toàn bộ cột đã tick" disabled="@(Busy || SelectedColumnNames.Count == 0)" @onclick="BulkDropSelectedColumnsAsync"><i class="fa-duotone fa-solid fa-trash-list"></i> Xóa tick (@SelectedColumnNames.Count)</button>
                        </div>
                        <div class="ct-sql-block-list">
                            @foreach (var col in Columns)
                            {
                                <div class="ct-sql-block ct-contextable @(IsColumnSelected(col.Name) ? "is-selected" : null)" @key="col.Name" @oncontextmenu:preventDefault="true" @oncontextmenu="args => OpenColumnContextMenu(args, col)" title="Chuột phải để mở menu nhanh cho cột">
                                    <div class="ct-sql-block-head">
                                        <div class="ct-sql-record-select-head">
                                            <input class="form-check-input" type="checkbox" checked="@IsColumnSelected(col.Name)" @onchange="args => ToggleColumnSelection(col.Name, args.Value)" />
                                            <div><strong><i class="fa-duotone fa-solid fa-keyboard"></i> @col.Name</strong><div class="ct-muted small">#@col.Ordinal · @(string.IsNullOrWhiteSpace(col.FullDataType) ? col.DataType : col.FullDataType) @(string.IsNullOrWhiteSpace(col.Comment) ? string.Empty : "· " + col.Comment)</div></div>
                                        </div>
                                        <div class="d-flex flex-wrap gap-1"><span class="badge text-bg-light border">@(col.IsNullable ? "NULL" : "NOT NULL")</span>@if (col.IsPrimaryKey){<span class="badge text-bg-warning">PRIMARY</span>}</div>
                                    </div>
                                    <div class="ct-sql-block-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Sửa cột" @onclick="() => OpenEditColumn(col)"><i class="fa-duotone fa-solid fa-pen"></i> Sửa</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa cột" @onclick="() => OpenDropColumn(col)"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa</button>
                                    </div>
                                </div>
                            }
                            @if (Columns.Count == 0)
                            {
                                <div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa chọn bảng hoặc bảng chưa có cột.</div>
                            }
                        </div>
                    </div>
                    <div class="ct-sql-browser-pane is-wide">
                        <div class="ct-pane-head is-searchable"><strong><i class="fa-duotone fa-solid fa-key"></i> Key / Index</strong><input class="form-control form-control-sm" placeholder="Tìm key/index..." value="@IndexSearch" @oninput="OnIndexSearchInputAsync" /><button class="btn btn-sm btn-primary" type="button" disabled="@(Busy || SelectedTable is null)" @onclick="OpenAddIndex"><i class="fa-duotone fa-solid fa-plus"></i></button></div>
                        <div class="ct-sql-block-list">
                            @foreach (var idx in Indexes)
                            {
                                <div class="ct-sql-block ct-contextable" @key="idx.Name" @oncontextmenu:preventDefault="true" @oncontextmenu="args => OpenIndexContextMenu(args, idx)">
                                    <div class="ct-sql-block-head">
                                        <div><strong><i class="fa-duotone fa-solid @(idx.IsPrimary ? "fa-key" : "fa-diagram-project")"></i> @idx.Name</strong><div class="ct-muted small">@idx.Type · @(string.Join(", ", idx.Columns))</div></div>
                                        <div class="d-flex flex-wrap gap-1"><span class="badge text-bg-light border">@idx.Columns.Count cột</span>@if (idx.IsUnique){<span class="badge text-bg-info">UNIQUE</span>}@if (idx.IsPrimary){<span class="badge text-bg-warning">PRIMARY</span>}</div>
                                    </div>
                                    <div class="ct-sql-block-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditIndex(idx)"><i class="fa-duotone fa-solid fa-pen"></i> Sửa</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => OpenDropIndex(idx)"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa</button>
                                    </div>
                                </div>
                            }
                            @if (Indexes.Count == 0)
                            {
                                <div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có key/index hoặc chưa chọn bảng.</div>
                            }
                        </div>
                    </div>
                    <div class="ct-sql-browser-pane is-wide">
                        <div class="ct-pane-head is-searchable"><strong><i class="fa-duotone fa-solid fa-link"></i> Foreign Key / Relation</strong><input class="form-control form-control-sm" placeholder="Tìm khóa ngoại..." value="@ForeignKeySearch" @oninput="OnForeignKeySearchInputAsync" /><button class="btn btn-sm btn-primary" type="button" disabled="@(Busy || SelectedTable is null || Columns.Count == 0)" @onclick="OpenAddForeignKey"><i class="fa-duotone fa-solid fa-plus"></i></button></div>
                        <div class="ct-sql-block-list">
                            @foreach (var fk in ForeignKeys)
                            {
                                <div class="ct-sql-block ct-contextable ct-sql-fk-card" @key="fk.ConstraintName + fk.ColumnName" @oncontextmenu:preventDefault="true" @oncontextmenu="args => OpenForeignKeyContextMenu(args, fk)">
                                    <div class="ct-sql-block-head">
                                        <div><strong><i class="fa-duotone fa-solid fa-link"></i> @fk.ConstraintName</strong><div class="ct-sql-fk-relation mt-1"><span>@($"{fk.TableName}.{fk.ColumnName}")</span><i class="fa-duotone fa-solid fa-arrow-right-long"></i><span>@($"{fk.ReferencedTableName}.{fk.ReferencedColumnName}")</span></div></div>
                                        <div class="d-flex flex-wrap gap-1"><span class="badge text-bg-light border">UPDATE @fk.UpdateRule</span><span class="badge text-bg-light border">DELETE @fk.DeleteRule</span></div>
                                    </div>
                                    <div class="ct-sql-block-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditForeignKey(fk)"><i class="fa-duotone fa-solid fa-pen"></i> Sửa</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => OpenDropForeignKey(fk)"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa</button>
                                    </div>
                                </div>
                            }
                            @if (ForeignKeys.Count == 0)
                            {
                                <div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có khóa ngoại hoặc chưa chọn bảng.</div>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (SqlTab == "records")
            {
                <div class="ct-sql-record-toolbar">
                    <div>
                        <strong><i class="fa-duotone fa-solid fa-table-list"></i> @(SelectedDatabase ?? "database") / @(SelectedTable?.FullName ?? "table")</strong>
                        <div class="ct-muted small">Record dạng block, tìm kiếm realtime qua SignalR.</div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <input class="form-control" placeholder="Tìm key/item/record..." value="@RecordSearch" @oninput="OnRecordSearchInputAsync" />
                        <select class="form-select" value="@RecordPageSize" @onchange="OnRecordPageSizeChangedAsync"><option value="10">10</option><option value="20">20</option><option value="50">50</option><option value="100">100</option></select>
                        <label class="ct-select-all-label" title="Tick/bỏ tick toàn bộ record trên trang hiện tại"><input class="form-check-input" type="checkbox" checked="@AreAllCurrentRecordsSelected" @onchange="args => ToggleAllCurrentRecords(args.Value)" /> all record</label>
                        <button type="button" class="btn btn-primary" title="Tải record" disabled="@(Busy || SelectedTable is null)" @onclick="LoadRecordsAsync"><i class="fa-duotone fa-solid fa-magnifying-glass"></i> Tải</button>
                        <button type="button" class="btn btn-success" title="Thêm 1 record" disabled="@(Busy || SelectedTable is null || Columns.Count == 0)" @onclick="OpenInsertRecord"><i class="fa-duotone fa-solid fa-plus"></i> Thêm record</button>
                        <button type="button" class="btn btn-outline-success" title="Thêm nhiều record cùng lúc" disabled="@(Busy || SelectedTable is null || Columns.Count == 0)" @onclick="OpenBulkInsertRecords"><i class="fa-duotone fa-solid fa-layer-plus"></i> Thêm nhiều record</button>
                        <button type="button" class="btn btn-outline-danger" title="Xóa toàn bộ record đã tick" disabled="@(Busy || SelectedRecordRows.Count == 0)" @onclick="BulkDeleteSelectedRecordsAsync"><i class="fa-duotone fa-solid fa-trash-list"></i> Xóa record tick (@SelectedRecordRows.Count)</button>
                    </div>
                </div>

                <div class="ct-sql-record-block-grid mt-3">
                    @if (RecordPage?.Rows?.Count > 0)
                    {
                        @foreach (var row in RecordPage.Rows)
                        {
                            <div class="@GetRecordBlockClass(row)" @key="string.Join('|', row.Values)" @oncontextmenu:preventDefault="true" @oncontextmenu="args => OpenRecordContextMenu(args, row)" title="Chuột phải để mở menu nhanh cho record, tick checkbox để bulk/export">
                                <div class="ct-sql-block-head">
                                    <div class="ct-sql-record-select-head">
                                        <input class="form-check-input" type="checkbox" checked="@IsRecordSelected(row)" @onchange="args => ToggleRecordSelection(row, args.Value)" />
                                        <div><strong><i class="fa-duotone fa-solid fa-cube"></i> Record</strong><div class="ct-muted small">@Columns.Count cột · tick để export selected rows</div></div>
                                    </div>
                                    <div class="ct-sql-block-actions"><button class="btn btn-sm btn-outline-secondary" type="button" title="Sửa record" @onclick="() => OpenEditRecord(row)"><i class="fa-duotone fa-solid fa-pen"></i> Sửa</button><button class="btn btn-sm btn-outline-danger" type="button" title="Xóa record" @onclick="() => OpenDeleteRecord(row)"><i class="fa-duotone fa-solid fa-trash"></i> Xóa</button></div>
                                </div>
                                <div class="ct-sql-record-fields">
                                    @foreach (var column in Columns.Take(12))
                                    {
                                        <div class="ct-sql-record-field"><span>@column.Name</span><code>@(row.TryGetValue(column.Name, out var value) ? value : null)</code></div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có record.</div>
                    }
                </div>

                <div class="ct-pagination p-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                    <div class="ct-muted small">Trang @RecordPageNumber / @(RecordPage?.TotalPages ?? 1) · Tổng @(RecordPage?.TotalRows ?? 0) record</div>
                    <div class="btn-group"><button class="btn btn-outline-secondary" type="button" disabled="@(RecordPageNumber <= 1 || Busy)" @onclick="() => ChangeRecordPageAsync(RecordPageNumber - 1)"><i class="fa-duotone fa-solid fa-chevron-left"></i> Trước</button><button class="btn btn-outline-secondary" type="button" disabled="@(RecordPage is null || RecordPageNumber >= RecordPage.TotalPages || Busy)" @onclick="() => ChangeRecordPageAsync(RecordPageNumber + 1)">Sau <i class="fa-duotone fa-solid fa-chevron-right"></i></button></div>
                </div>
            }
            else if (SqlTab == "query")
            {
                <div class="ct-query-studio ct-query-studio-pro">
                    <aside class="ct-query-schema-menu">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-list-tree"></i> Menu bảng / cột / key</strong>
                            <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@(Busy || SelectedProfile is null || string.IsNullOrWhiteSpace(SelectedDatabase))" @onclick="LoadTablesAsync"><i class="fa-duotone fa-solid fa-rotate"></i></button>
                        </div>
                        <input class="form-control form-control-sm mb-2" placeholder="Tìm bảng, cột, key..." value="@QueryObjectSearch" @oninput="OnQueryObjectSearchInput" />

                        <div class="ct-query-menu-section">
                            <div class="ct-query-menu-title"><i class="fa-duotone fa-solid fa-table"></i> Bảng / view <span>@GetQueryTables().Count</span></div>
                            <div class="ct-query-menu-list">
                                @foreach (var table in GetQueryTables())
                                {
                                    <button type="button"
                                            class="ct-query-menu-item @(SelectedTable?.FullName == table.FullName ? "active" : null)"
                                            title="Click để chọn, double click để chèn vào query"
                                            @onclick="() => SelectTableFromQueryAsync(table)"
                                            @ondblclick="() => InsertTableIntoQueryAsync(table)">
                                        <span><i class="fa-duotone fa-solid fa-table"></i> @table.FullName</span>
                                        <small>@table.Type</small>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="ct-query-menu-section">
                            <div class="ct-query-menu-title"><i class="fa-duotone fa-solid fa-columns-3"></i> Cột / key <span>@GetQueryColumns().Count</span></div>
                            <div class="ct-query-menu-list is-columns">
                                @foreach (var column in GetQueryColumns())
                                {
                                    <button type="button"
                                            class="ct-query-menu-item is-column @(column.IsPrimaryKey ? "is-key" : null)"
                                            title="Click để chọn nhanh WHERE, double click để chèn cột"
                                            @onclick="() => InsertWhereColumnIntoQuery(column)"
                                            @ondblclick="() => InsertColumnIntoQuery(column)">
                                        <span><i class="fa-duotone fa-solid @(column.IsPrimaryKey ? "fa-key" : "fa-input-text")"></i> @column.Name</span>
                                        <small>@column.DataType</small>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="ct-query-menu-section">
                            <div class="ct-query-menu-title"><i class="fa-duotone fa-solid fa-key"></i> Key / Index <span>@GetQueryIndexes().Count</span></div>
                            <div class="ct-query-menu-list is-columns">
                                @foreach (var index in GetQueryIndexes())
                                {
                                    <button type="button"
                                            class="ct-query-menu-item is-column @(index.IsPrimary ? "is-key" : null)"
                                            title="Double click để chèn các cột index vào query"
                                            @onclick="() => InsertIndexWhereIntoQuery(index)"
                                            @ondblclick="() => InsertIndexColumnsIntoQuery(index)">
                                        <span><i class="fa-duotone fa-solid @(index.IsPrimary ? "fa-key" : "fa-diagram-project")"></i> @index.Name</span>
                                        <small>@index.Type · @(string.Join(", ", index.Columns))</small>
                                    </button>
                                }
                            </div>
                        </div>
                    </aside>

                    <div class="ct-query-editor-panel">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-terminal"></i> Query nhanh</strong>
                            <span class="ct-muted small">Double click bảng/cột bên trái để chèn nhanh</span>
                        </div>

                        <div class="ct-query-quick-builder">
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(SelectedTable is null)" @onclick="BuildSelectQuery"><i class="fa-duotone fa-solid fa-table-list"></i> SELECT</button>
                            <button type="button" class="btn btn-sm btn-outline-success" disabled="@(SelectedTable is null || Columns.Count == 0)" @onclick="BuildInsertQuery"><i class="fa-duotone fa-solid fa-square-plus"></i> INSERT</button>
                            <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(SelectedTable is null || Columns.Count == 0)" @onclick="BuildUpdateQuery"><i class="fa-duotone fa-solid fa-pen-to-square"></i> UPDATE</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(SelectedTable is null || Columns.Count == 0)" @onclick="BuildDeleteQuery"><i class="fa-duotone fa-solid fa-trash-can"></i> DELETE</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(SelectedTable is null)" @onclick="InsertSelectedTableIntoQuery"><i class="fa-duotone fa-solid fa-arrow-turn-down-right"></i> Chèn bảng</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Columns.Count == 0)" @onclick="InsertAllColumnsIntoQuery"><i class="fa-duotone fa-solid fa-columns-3"></i> Chèn all cột</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Columns.All(x => !x.IsPrimaryKey))" @onclick="InsertPrimaryWhereIntoQuery"><i class="fa-duotone fa-solid fa-key"></i> WHERE key</button>
                        </div>

                        <div class="ct-sql-template-grid mb-3">
                            @foreach (var template in QueryTemplates)
                            {
                                <button type="button" class="ct-sql-template-card" @onclick="() => UseTemplate(template)">
                                    <strong><i class="fa-duotone fa-solid @template.Icon"></i> @template.Title</strong>
                                    <span>@template.Description</span>
                                </button>
                            }
                        </div>

                        <textarea class="form-control ct-sql-query-box" rows="14" @bind="QueryText" placeholder="SELECT * FROM table_name LIMIT 100;"></textarea>
                        <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                            <span class="input-group input-group-sm" style="max-width:220px"><span class="input-group-text">Max rows</span><input class="form-control" type="number" min="1" max="5000" @bind="QueryMaxRows" /></span>
                            <button type="button" class="btn btn-primary" disabled="@(Busy || SelectedProfile is null)" @onclick="RunQueryAsync"><i class="fa-duotone fa-solid fa-play"></i> Chạy query</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="ClearQuery"><i class="fa-duotone fa-solid fa-eraser"></i> Xóa query</button>
                        </div>
                    </div>

                    <div class="ct-query-result-panel">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-square-poll-horizontal"></i> Kết quả + CRUD trực tiếp</strong>
                            <span>@QueryResult?.Message</span>
                        </div>

                        @if (CanCrudQueryResult)
                        {
                            <div class="ct-query-inline-add">
                                <div class="ct-query-inline-add-head">
                                    <strong><i class="fa-duotone fa-solid fa-square-plus"></i> Thêm record vào @SelectedTable?.FullName</strong>
                                    <button type="button" class="btn btn-sm btn-success" disabled="@Busy" @onclick="InsertQueryResultRowAsync"><i class="fa-duotone fa-solid fa-floppy-disk"></i> Insert</button>
                                </div>
                                <div class="ct-query-inline-grid">
                                    @foreach (var column in QueryCrudColumns)
                                    {
                                        <label class="ct-query-cell-editor" @key="column.Name">
                                            <span>@column.Name @if (column.IsPrimaryKey) { <i class="fa-duotone fa-solid fa-key text-warning"></i> }</span>
                                            <input class="form-control form-control-sm" value="@GetQueryNewValue(column.Name)" @oninput="args => SetQueryNewValue(column.Name, args.Value?.ToString())" placeholder="@column.DataType" />
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        @RenderQueryCrudRows()
                    </div>
                </div>
            }
            else if (SqlTab == "importexport")
            {
                <div class="ct-query-studio">
                    <div class="ct-query-left">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-file-export"></i> Export SQL</strong>
                            <span class="ct-muted small">SQL-13: chọn scope giống phpMyAdmin, không còn auto xuất nhầm bảng đầu tiên.</span>
                        </div>
                        <div class="ct-sql-connect-form ct-sql-import-export-options mb-3">
                            <div class="ct-form-block">
                                <label class="form-label">Chế độ</label>
                                <select class="form-select" value="@ExportMode" @onchange="OnExportModeChanged">
                                    <option value="quick">Quick · cấu trúc + dữ liệu + drop</option>
                                    <option value="custom">Custom · tự chọn tùy chọn</option>
                                </select>
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label">Scope export</label>
                                <select class="form-select" value="@ExportScope" @onchange="OnExportScopeChanged">
                                    <option value="database">Toàn database</option>
                                    <option value="table">Bảng hiện tại</option>
                                    <option value="selectedRows">Record đã tick</option>
                                </select>
                                <div class="ct-muted small mt-1">@ExportScopeHint</div>
                            </div>
                            <div class="ct-form-block"><label class="form-label">Max rows mỗi bảng</label><input class="form-control" type="number" min="1" max="5000" disabled="@(IsSelectedRowsExport)" @bind="ExportMaxRows" /></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expDrop" disabled="@(IsQuickExport)" @bind="ExportIncludeDrop" /><label class="form-check-label" for="expDrop">Gồm DROP</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expStruct" disabled="@(IsQuickExport || IsSelectedRowsExport)" @bind="ExportStructure" /><label class="form-check-label" for="expStruct">Gồm cấu trúc</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expData" disabled="@(IsQuickExport)" @bind="ExportData" /><label class="form-check-label" for="expData">Gồm dữ liệu</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expIndex" disabled="@(IsQuickExport || IsSelectedRowsExport)" @bind="ExportIncludeIndexes" /><label class="form-check-label" for="expIndex">Gồm index/key</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expFk" disabled="@(IsQuickExport || IsSelectedRowsExport)" @bind="ExportIncludeForeignKeys" /><label class="form-check-label" for="expFk">Gồm foreign key</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expViews" disabled="@(IsQuickExport || IsSelectedRowsExport)" @bind="ExportIncludeViews" /><label class="form-check-label" for="expViews">Gồm view</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expTriggers" disabled="@(IsQuickExport || !IsDatabaseExport)" @bind="ExportIncludeTriggers" /><label class="form-check-label" for="expTriggers">Trigger</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expRoutines" disabled="@(IsQuickExport || !IsDatabaseExport)" @bind="ExportIncludeRoutines" /><label class="form-check-label" for="expRoutines">Routine</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="expEvents" disabled="@(IsQuickExport || !IsDatabaseExport)" @bind="ExportIncludeEvents" /><label class="form-check-label" for="expEvents">Event</label></div></div>
                        </div>
                        <div class="ct-sql-export-actions">
                            <button class="btn btn-primary" type="button" disabled="@(Busy || SelectedProfile is null || string.IsNullOrWhiteSpace(SelectedDatabase) || !CanRunExport)" @onclick="RunExportAsync"><i class="fa-duotone fa-solid fa-file-export"></i> Tạo script export</button>
                            <button class="btn btn-outline-secondary" type="button" disabled="@(string.IsNullOrWhiteSpace(ExportText))" @onclick="CopyExportAsync"><i class="fa-duotone fa-solid fa-copy"></i> Copy</button>
                            <button class="btn btn-success" type="button" disabled="@(string.IsNullOrWhiteSpace(ExportText))" @onclick="DownloadExportAsync"><i class="fa-duotone fa-solid fa-download"></i> Tải .sql</button>
                        </div>
                        <textarea class="form-control ct-sql-query-box mt-3" rows="14" @bind="ExportText" placeholder="Script export sẽ hiện ở đây để copy hoặc tải thành file .sql"></textarea>
                    </div>
                    <div class="ct-query-right">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-file-import"></i> Import SQL</strong>
                            <span class="ct-muted small">Hỗ trợ paste hoặc chọn file .sql/.txt/.zip/.gz rồi import qua SignalR.</span>
                        </div>
                        <div class="ct-sql-connect-form ct-sql-import-export-options mb-3">
                            <div class="ct-form-block ct-sql-file-picker">
                                <label class="form-label">File import</label>
                                <InputFile OnChange="OnImportFileChangedAsync" accept=".sql,.txt,.zip,.gz" />
                                <div class="ct-muted small mt-1">@ImportFileStatus</div>
                            </div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="impFk" @bind="ImportDisableForeignKeyChecks" /><label class="form-check-label" for="impFk">Tạm tắt FK check nếu hỗ trợ</label></div></div>
                            <div class="ct-form-block ct-form-switches"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="impContinue" @bind="ImportContinueOnError" /><label class="form-check-label" for="impContinue">Tiếp tục khi lỗi</label></div></div>
                            <div class="ct-form-block"><label class="form-label">Batch size/log hint</label><input class="form-control" type="number" min="1" max="5000" @bind="ImportBatchSize" /></div>
                        </div>
                        <textarea class="form-control ct-sql-query-box" rows="18" @bind="ImportText" placeholder="Paste script .sql hoặc chọn file .sql/.zip/.gz rồi bấm Import"></textarea>
                        <div class="ct-sql-export-actions mt-3">
                            <button class="btn btn-success" type="button" disabled="@(Busy || SelectedProfile is null || string.IsNullOrWhiteSpace(ImportText))" @onclick="RunImportAsync"><i class="fa-duotone fa-solid fa-file-import"></i> Import vào database đang chọn</button>
                            <button class="btn btn-outline-secondary" type="button" disabled="@(string.IsNullOrWhiteSpace(ImportText))" @onclick="ClearImportText"><i class="fa-duotone fa-solid fa-eraser"></i> Xóa nội dung</button>
                        </div>
                    </div>
                </div>
            }
            else if (SqlTab == "maintenance")
            {
                <div class="ct-sql-maintenance-grid">
                    <div class="ct-sql-maint-card">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-screwdriver-wrench"></i> SQL-11 Maintenance bảng</strong>
                            <span class="ct-muted small">Analyze, check, optimize, repair, checksum, truncate</span>
                        </div>
                        <div class="ct-sql-connect-form mb-3">
                            <div class="ct-form-block">
                                <label class="form-label">Bảng đang chọn</label>
                                <select class="form-select" value="@(SelectedTable?.FullName ?? string.Empty)" @onchange="OnMaintenanceTableChangedAsync">
                                    <option value="">-- chọn bảng --</option>
                                    @foreach (var table in Tables)
                                    {
                                        <option value="@table.FullName">@table.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label">Action</label>
                                <select class="form-select" @bind="MaintenanceAction">
                                    <option value="check">CHECK</option>
                                    <option value="analyze">ANALYZE</option>
                                    <option value="optimize">OPTIMIZE</option>
                                    <option value="repair">REPAIR</option>
                                    <option value="checksum">CHECKSUM</option>
                                    <option value="truncate">TRUNCATE / EMPTY</option>
                                </select>
                            </div>
                            <div class="ct-form-block ct-form-switches">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" type="checkbox" id="maintDanger" @bind="MaintenanceConfirmDangerous" />
                                    <label class="form-check-label" for="maintDanger">Xác nhận thao tác nguy hiểm</label>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button class="btn btn-primary" type="button" disabled="@(Busy || SelectedProfile is null || SelectedTable is null || string.IsNullOrWhiteSpace(SelectedDatabase))" @onclick="RunMaintenanceAsync"><i class="fa-duotone fa-solid fa-play"></i> Chạy maintenance</button>
                            <button class="btn btn-outline-secondary" type="button" disabled="@(Busy || SelectedProfile is null)" @onclick="LoadProcessesAsync"><i class="fa-duotone fa-solid fa-list"></i> Refresh process</button>
                            <button class="btn btn-outline-secondary" type="button" disabled="@(Busy || SelectedProfile is null)" @onclick="LoadVariablesAsync"><i class="fa-duotone fa-solid fa-sliders"></i> Refresh variables/status</button>
                        </div>
                        @if (MaintenanceResult is not null)
                        {
                            <div class="alert @(MaintenanceResult.Success ? "alert-success" : "alert-danger") py-2"><i class="fa-duotone fa-solid @(MaintenanceResult.Success ? "fa-circle-check" : "fa-triangle-exclamation")"></i> @MaintenanceResult.Message</div>
                            @RenderMaintenanceResultTable()
                        }
                    </div>

                    <div class="ct-sql-maint-card">
                        <div class="ct-pane-head is-searchable">
                            <strong><i class="fa-duotone fa-solid fa-sliders"></i> Variables / Status</strong>
                            <input class="form-control form-control-sm" placeholder="Tìm variable/status..." value="@VariableSearch" @oninput="OnVariableSearchInputAsync" />
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="includeStatus" checked="@VariableIncludeStatus" @onchange="OnVariableIncludeStatusChangedAsync" />
                            <label class="form-check-label" for="includeStatus">Gồm status variables</label>
                        </div>
                        <div class="ct-sql-variable-list">
                            @foreach (var item in Variables.Take(300))
                            {
                                <div class="ct-sql-variable-row" @key="item.Group + item.Name">
                                    <span class="badge text-bg-light border">@item.Group</span>
                                    <strong>@item.Name</strong>
                                    <code>@item.Value</code>
                                </div>
                            }
                            @if (Variables.Count == 0)
                            {
                                <div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có variables/status.</div>
                            }
                        </div>
                    </div>

                    <div class="ct-sql-maint-card is-wide">
                        <div class="ct-pane-head">
                            <strong><i class="fa-duotone fa-solid fa-wave-pulse"></i> Process list</strong>
                            <span class="ct-muted small">Kill process cần quyền tương ứng.</span>
                        </div>
                        <div class="table-responsive ct-sql-table-wrap">
                            <table class="table table-sm table-hover align-middle">
                                <thead><tr><th>ID</th><th>User</th><th>Host</th><th>DB</th><th>Command</th><th>Time</th><th>State</th><th>Info</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var process in Processes)
                                    {
                                        <tr @key="process.Id">
                                            <td><code>@process.Id</code></td>
                                            <td>@process.User</td>
                                            <td>@process.Host</td>
                                            <td>@process.Database</td>
                                            <td>@process.Command</td>
                                            <td>@process.Time</td>
                                            <td>@process.State</td>
                                            <td class="text-truncate" style="max-width:360px">@process.Info</td>
                                            <td><button class="btn btn-sm btn-outline-danger" disabled="@(Busy || process.Id == "error")" @onclick="() => KillProcessAsync(process.Id)"><i class="fa-duotone fa-solid fa-ban"></i> Kill</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (SqlTab == "designer")
            {
                <div class="ct-sql-designer-panel">
                    <div class="ct-pane-head is-searchable">
                        <strong><i class="fa-duotone fa-solid fa-diagram-project"></i> SQL-12 Designer / Relation view</strong>
                        <input class="form-control form-control-sm" placeholder="Tìm bảng trong designer..." value="@DesignerSearch" @oninput="OnDesignerSearchInputAsync" />
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Busy || SelectedProfile is null || string.IsNullOrWhiteSpace(SelectedDatabase))" @onclick="LoadDesignerAsync"><i class="fa-duotone fa-solid fa-rotate"></i> Refresh</button>
                    </div>
                    <div class="ct-sql-designer-summary">
                        <span><i class="fa-duotone fa-solid fa-database"></i> @(Designer?.DatabaseName ?? SelectedDatabase ?? "database")</span>
                        <span><i class="fa-duotone fa-solid fa-table"></i> @(Designer?.Tables.Count ?? 0) bảng</span>
                        <span><i class="fa-duotone fa-solid fa-link"></i> @(Designer?.Relations.Count ?? 0) quan hệ</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ExportDesignerOverview"><i class="fa-duotone fa-solid fa-copy"></i> Export overview vào Query</button>
                    </div>
                    <div class="ct-sql-designer-canvas">
                        @if (Designer?.Tables.Count > 0)
                        {
                            @foreach (var table in Designer.Tables)
                            {
                                <div class="ct-sql-designer-table" style="left:@(table.X)px;top:@(table.Y)px" @key="table.FullName" @onclick="() => SelectDesignerTableAsync(table)">
                                    <div class="ct-sql-designer-table-head"><i class="fa-duotone fa-solid fa-table"></i> <strong>@table.FullName</strong><span>@(table.RowCount?.ToString() ?? "?") rows</span></div>
                                    <div class="ct-sql-designer-cols">
                                        @foreach (var col in table.Columns)
                                        {
                                            <div class="@(col.IsPrimaryKey ? "is-pk" : null)"><i class="fa-duotone fa-solid @(col.IsPrimaryKey ? "fa-key" : "fa-input-text")"></i> @col.Name <small>@col.DataType</small></div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có dữ liệu designer. Chọn database rồi bấm Refresh.</div>
                        }
                    </div>
                    <div class="ct-sql-relation-list mt-3">
                        <div class="ct-pane-head"><strong><i class="fa-duotone fa-solid fa-link"></i> Relations</strong></div>
                        @foreach (var rel in Designer?.Relations ?? Enumerable.Empty<SqlDesignerRelationDto>())
                        {
                            <button type="button" class="ct-sql-relation-row" @key="rel.ConstraintName + rel.FromTable + rel.FromColumn" @onclick="() => OpenRelationForeignKeyModal(rel)">
                                <strong>@rel.ConstraintName</strong>
                                <span>@($"{rel.FromTable}.{rel.FromColumn}")</span>
                                <i class="fa-duotone fa-solid fa-arrow-right-long"></i>
                                <span>@($"{rel.ToTable}.{rel.ToColumn}")</span>
                                <small>UPDATE @rel.UpdateRule · DELETE @rel.DeleteRule</small>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</div>


@if (ShowSqlContextMenu)
{
    <div class="ct-sql-context-backdrop" @onclick="CloseSqlContextMenu"></div>
    <div class="ct-sql-context-menu shadow-lg" style="@SqlContextMenuStyle" role="menu">
        <div class="ct-sql-context-head">
            <i class="fa-duotone fa-solid @SqlContextIcon"></i>
            <div>
                <strong>@SqlContextTitle</strong>
                <span>@SqlContextSubtitle</span>
            </div>
        </div>
        <div class="ct-sql-context-actions">
            @if (SqlContextKind == "database")
            {
                <button type="button" @onclick="SelectContextDatabaseAsync"><i class="fa-duotone fa-solid fa-hand-pointer"></i> Chọn database</button>
                <button type="button" @onclick="InsertContextDatabaseUseQuery"><i class="fa-duotone fa-solid fa-terminal"></i> Chèn USE vào query</button>
                <button type="button" @onclick="InsertContextDatabaseName"><i class="fa-duotone fa-solid fa-copy"></i> Chèn tên DB</button>
                <button type="button" @onclick="OpenRenameDatabaseFromContext"><i class="fa-duotone fa-solid fa-pen-to-square"></i> Sửa / đổi tên DB</button>
                <button type="button" @onclick="OpenCreateTableFromContext"><i class="fa-duotone fa-solid fa-table-circle-plus"></i> Tạo bảng trong DB</button>
                <button type="button" @onclick="ExportContextDatabase"><i class="fa-duotone fa-solid fa-file-export"></i> Xuất dữ liệu DB</button>
                <button type="button" class="danger" @onclick="OpenDropDatabaseFromContext"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa database</button>
            }
            else if (SqlContextKind == "table")
            {
                <button type="button" @onclick="SelectContextTableAsync"><i class="fa-duotone fa-solid fa-hand-pointer"></i> Chọn bảng</button>
                <button type="button" @onclick="InsertContextTableName"><i class="fa-duotone fa-solid fa-copy"></i> Chèn tên bảng</button>
                <button type="button" @onclick="InsertContextSelectQuery"><i class="fa-duotone fa-solid fa-list"></i> SELECT bảng</button>
                <button type="button" @onclick="ExportContextTable"><i class="fa-duotone fa-solid fa-file-export"></i> Xuất bảng</button>
                <button type="button" @onclick="OpenCreateColumnFromContext"><i class="fa-duotone fa-solid fa-plus"></i> Thêm cột</button>
                <button type="button" @onclick="OpenRenameTableFromContext"><i class="fa-duotone fa-solid fa-pen-to-square"></i> Sửa bảng</button>
                <button type="button" @onclick="CopyTableStructureFromContextAsync"><i class="fa-duotone fa-solid fa-clone"></i> Duplicate cấu trúc</button>
                <button type="button" @onclick="TruncateTableFromContextAsync"><i class="fa-duotone fa-solid fa-broom"></i> Empty / truncate</button>
                <button type="button" @onclick="CopyContextBlock"><i class="fa-duotone fa-solid fa-copy"></i> Copy block</button>
                <button type="button" @onclick="PasteContextBlockAsync"><i class="fa-duotone fa-solid fa-paste"></i> Paste block</button>
                <button type="button" @onclick="CutContextBlock"><i class="fa-duotone fa-solid fa-scissors"></i> Cut</button>
                <button type="button" class="danger" @onclick="OpenDropTableFromContext"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa bảng</button>
            }
            else if (SqlContextKind == "column")
            {
                <button type="button" @onclick="InsertContextColumnName"><i class="fa-duotone fa-solid fa-copy"></i> Chèn tên cột</button>
                <button type="button" @onclick="InsertContextColumnWhere"><i class="fa-duotone fa-solid fa-filter"></i> Chèn WHERE cột</button>
                <button type="button" @onclick="OpenEditColumnFromContext"><i class="fa-duotone fa-solid fa-pen"></i> Sửa cột</button>
                <button type="button" @onclick="CopyContextBlock"><i class="fa-duotone fa-solid fa-copy"></i> Copy cột</button>
                <button type="button" @onclick="PasteContextBlockAsync"><i class="fa-duotone fa-solid fa-paste"></i> Paste cột</button>
                <button type="button" @onclick="CutContextBlock"><i class="fa-duotone fa-solid fa-scissors"></i> Cut cột</button>
                <button type="button" class="danger" @onclick="OpenDropColumnFromContext"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa cột</button>
            }
            else if (SqlContextKind == "index")
            {
                <button type="button" @onclick="InsertContextIndexColumns"><i class="fa-duotone fa-solid fa-copy"></i> Chèn cột key</button>
                <button type="button" @onclick="InsertContextIndexWhere"><i class="fa-duotone fa-solid fa-filter"></i> WHERE theo key</button>
                <button type="button" @onclick="OpenEditIndexFromContext"><i class="fa-duotone fa-solid fa-pen"></i> Sửa key/index</button>
                <button type="button" @onclick="CopyContextBlock"><i class="fa-duotone fa-solid fa-copy"></i> Copy key/index</button>
                <button type="button" class="danger" @onclick="OpenDropIndexFromContext"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa key/index</button>
            }
            else if (SqlContextKind == "foreign")
            {
                <button type="button" @onclick="InsertContextForeignKeySql"><i class="fa-duotone fa-solid fa-terminal"></i> Chèn SQL relation</button>
                <button type="button" @onclick="OpenEditForeignKeyFromContext"><i class="fa-duotone fa-solid fa-pen"></i> Sửa khóa ngoại</button>
                <button type="button" @onclick="CopyContextBlock"><i class="fa-duotone fa-solid fa-copy"></i> Copy khóa ngoại</button>
                <button type="button" @onclick="PasteContextBlockAsync"><i class="fa-duotone fa-solid fa-paste"></i> Paste khóa ngoại</button>
                <button type="button" class="danger" @onclick="OpenDropForeignKeyFromContext"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa khóa ngoại</button>
            }
            else if (SqlContextKind == "record")
            {
                <button type="button" @onclick="OpenEditRecordFromContext"><i class="fa-duotone fa-solid fa-pen"></i> Sửa record</button>
                <button type="button" @onclick="InsertContextRecordWhere"><i class="fa-duotone fa-solid fa-key"></i> Query theo key</button>
                <button type="button" @onclick="CopyContextBlock"><i class="fa-duotone fa-solid fa-copy"></i> Copy record</button>
                <button type="button" @onclick="PasteContextBlockAsync"><i class="fa-duotone fa-solid fa-paste"></i> Paste record</button>
                <button type="button" @onclick="CutContextBlock"><i class="fa-duotone fa-solid fa-scissors"></i> Cut record</button>
                <button type="button" class="danger" @onclick="OpenDeleteRecordFromContext"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa record</button>
            }
        </div>
    </div>
}

@if (ShowProfileModal && EditingProfile is not null)
{
    <div class="modal fade show ct-modal" tabindex="-1" style="display:block;" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-xl modal-dialog-centered ct-sql-modal-dialog ct-sql-profile-modal-dialog">
            <div class="modal-content border-0 shadow-lg ct-resizable-modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title"><i class="fa-duotone fa-solid fa-plug-circle-bolt"></i> @ProfileModalTitle</h5>
                        <div class="ct-muted small">CRUD tài khoản trong <code>connect.json</code> bằng modal. Test kết nối có thể chạy trực tiếp từ form.</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseProfileModal"></button>
                </div>
                <div class="modal-body">
                    @if (ProfileModalMode == "delete")
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2">
                            <i class="fa-duotone fa-solid fa-triangle-exclamation mt-1"></i>
                            <div>
                                <strong>Xóa tài khoản SQL?</strong>
                                <div>Tài khoản <strong>@EditingProfile.Name</strong> sẽ bị xóa khỏi <code>connect.json</code>. Database thật không bị xóa.</div>
                            </div>
                        </div>
                        <div class="ct-sql-profile-delete-preview">
                            <span><i class="fa-duotone fa-solid @GetSqlTypeIcon(EditingProfile.TypeConnect)"></i> @NormalizeSqlType(EditingProfile.TypeConnect)</span>
                            <span><i class="fa-duotone fa-solid fa-network-wired"></i> @BuildEndpoint(EditingProfile)</span>
                            <span><i class="fa-duotone fa-solid fa-database"></i> @(string.IsNullOrWhiteSpace(EditingProfile.Database) ? "chưa chọn DB" : EditingProfile.Database)</span>
                        </div>
                    }
                    else
                    {
                        <div class="ct-sql-profile-modal-grid">
                            <div class="ct-form-block">
                                <label class="form-label"><i class="fa-duotone fa-solid fa-signature"></i> Tên cấu hình</label>
                                <input class="form-control form-control-lg" @bind="EditingProfile.Name" placeholder="VD: Local MySQL, VPS MariaDB..." />
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label"><i class="fa-duotone fa-solid fa-layer-group"></i> Loại SQL</label>
                                <select class="form-select form-select-lg" @bind="EditingProfile.TypeConnect">
                                    <option value="mysql">MySQL</option>
                                    <option value="mariadb">MariaDB</option>
                                    <option value="sqlserver">SQL Server / MSSQL</option>
                                </select>
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label"><i class="fa-duotone fa-solid fa-server"></i> Host</label>
                                <input class="form-control" @bind="EditingProfile.Host" placeholder="127.0.0.1" />
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label"><i class="fa-duotone fa-solid fa-ethernet"></i> Port</label>
                                <input class="form-control" @bind="EditingProfile.Port" placeholder="3306 / 1433" />
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label"><i class="fa-duotone fa-solid fa-user"></i> User</label>
                                <input class="form-control" @bind="EditingProfile.User" placeholder="root / sa..." />
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label"><i class="fa-duotone fa-solid fa-key"></i> Password</label>
                                <input class="form-control" type="password" @bind="EditingProfile.Password" placeholder="Có thể để rỗng nếu Allow no password bật" />
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label"><i class="fa-duotone fa-solid fa-database"></i> Database mặc định</label>
                                <input class="form-control" @bind="EditingProfile.Database" placeholder="có thể để trống" />
                            </div>
                            <div class="ct-form-block">
                                <label class="form-label"><i class="fa-duotone fa-solid fa-stopwatch"></i> Timeout giây</label>
                                <input class="form-control" type="number" min="3" max="120" @bind="EditingProfile.TimeoutSeconds" />
                            </div>
                            <div class="ct-form-block ct-form-switches ct-profile-switches">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profileAllowNoPassword" @bind="EditingProfile.AllowNoPassword" />
                                    <label class="form-check-label" for="profileAllowNoPassword">Cho phép password rỗng</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profileSqlEncrypt" @bind="EditingProfile.Encrypt" />
                                    <label class="form-check-label" for="profileSqlEncrypt">Encrypt SQL Server</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profileTrustSqlCert" @bind="EditingProfile.TrustServerCertificate" />
                                    <label class="form-check-label" for="profileTrustSqlCert">Trust certificate</label>
                                </div>
                            </div>
                        </div>

                        <div class="ct-sql-profile-live-preview mt-3">
                            <span><i class="fa-duotone fa-solid @GetSqlTypeIcon(EditingProfile.TypeConnect)"></i> @NormalizeSqlType(EditingProfile.TypeConnect)</span>
                            <span><i class="fa-duotone fa-solid fa-network-wired"></i> @BuildEndpoint(EditingProfile)</span>
                            <span><i class="fa-duotone fa-solid fa-database"></i> @(string.IsNullOrWhiteSpace(EditingProfile.Database) ? "chưa chọn DB" : EditingProfile.Database)</span>
                        </div>
                    }
                </div>
                <div class="modal-footer flex-wrap">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseProfileModal">Hủy</button>
                    @if (ProfileModalMode != "delete")
                    {
                        <button class="btn btn-outline-primary" type="button" disabled="@(Busy || EditingProfile is null)" @onclick="TestSelectedProfileAsync"><i class="fa-duotone fa-solid fa-signal-stream"></i> Test từ form</button>
                        <button class="btn btn-success" type="button" disabled="@(Busy || EditingProfile is null)" @onclick="SaveProfileAsync"><i class="fa-duotone fa-solid fa-floppy-disk"></i> Lưu tài khoản</button>
                    }
                    else
                    {
                        <button class="btn btn-danger" type="button" disabled="@(Busy || EditingProfile is null)" @onclick="DeleteProfileAsync"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa tài khoản</button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (ShowDatabaseModal)
{
    <div class="modal fade show ct-modal" tabindex="-1" style="display:block;" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-xl modal-dialog-centered ct-sql-modal-dialog">
            <div class="modal-content border-0 shadow-lg ct-resizable-modal-content">
