    private sealed class SqlColumnTypeOption
    {
        public string Value { get; init; } = string.Empty;
        public string Label { get; init; } = string.Empty;
        public string Category { get; init; } = "Khác";
        public string DefaultLength { get; init; } = string.Empty;
        public string Hint { get; init; } = string.Empty;
        public bool SupportsLength { get; init; }
        public bool SupportsAutoIncrement { get; init; }
    }

    private IReadOnlyList<SqlColumnTypeOption> GetColumnTypeOptions()
    {
        var provider = SqlConnectConfigService.NormalizeType(SelectedProfile?.TypeConnect);
        return provider switch
        {
            "sqlserver" => SqlServerColumnTypes,
            "mariadb" => MariaDbColumnTypes,
            _ => MySqlColumnTypes
        };
    }

    private IReadOnlyList<SqlColumnTypeOption> GetQuickColumnTypeOptions()
        => GetColumnTypeOptions().Where(x => x.Value is "int" or "bigint" or "varchar" or "nvarchar" or "text" or "longtext" or "datetime" or "datetime2" or "decimal" or "bit" or "json" or "uniqueidentifier").Take(10).ToList();

    private bool IsKnownColumnType(string? value)
    {
        var normalized = NormalizeColumnTypeValue(value);
        return GetColumnTypeOptions().Any(x => string.Equals(NormalizeColumnTypeValue(x.Value), normalized, StringComparison.OrdinalIgnoreCase));
    }

    private bool HasExactColumnTypeOption(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        return GetColumnTypeOptions().Any(x => string.Equals(x.Value, value.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private bool IsColumnType(SqlColumnEditDto column, string value)
        => string.Equals(NormalizeColumnTypeValue(column.DataType), NormalizeColumnTypeValue(value), StringComparison.OrdinalIgnoreCase);

    private void ApplyColumnType(SqlColumnEditDto column, string value)
        => OnColumnDataTypeChanged(column, value);

    private void OnColumnDataTypeChanged(SqlColumnEditDto column, string? value)
    {
        column.DataType = string.IsNullOrWhiteSpace(value) ? GetDefaultColumnType() : value.Trim();
        var option = FindColumnTypeOption(column.DataType);
        if (option is not null)
        {
            column.Length = option.DefaultLength;
        }
        else if (!ColumnTypeSupportsLength(column.DataType))
        {
            column.Length = string.Empty;
        }

        if (!ColumnTypeSupportsAutoIncrement(column.DataType))
        {
            column.AutoIncrement = false;
        }
    }

    private void OnColumnAutoIncrementChanged(SqlColumnEditDto column, object? value)
    {
        column.AutoIncrement = ColumnTypeSupportsAutoIncrement(column.DataType) && value is bool checkedValue && checkedValue;
    }

    private string GetDefaultColumnType()
        => SqlConnectConfigService.NormalizeType(SelectedProfile?.TypeConnect) == "sqlserver" ? "nvarchar" : "varchar";

    private SqlColumnTypeOption? FindColumnTypeOption(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var trimmed = value.Trim();
        var options = GetColumnTypeOptions();
        var exact = options.FirstOrDefault(x => string.Equals(x.Value, trimmed, StringComparison.OrdinalIgnoreCase));
        if (exact is not null) return exact;
        var normalized = NormalizeColumnTypeValue(trimmed);
        return options.FirstOrDefault(x => string.Equals(NormalizeColumnTypeValue(x.Value), normalized, StringComparison.OrdinalIgnoreCase));
    }

    private bool ColumnTypeSupportsLength(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        if (value.Contains('(')) return false;
        var option = FindColumnTypeOption(value);
        if (option is not null) return option.SupportsLength;
        var upper = NormalizeColumnTypeValue(value).ToUpperInvariant();
        return upper.Contains("CHAR", StringComparison.Ordinal) || upper is "DECIMAL" or "NUMERIC" or "VARBINARY" or "BINARY" or "FLOAT" or "DOUBLE";
    }

    private bool ColumnTypeSupportsAutoIncrement(string? value)
    {
        var option = FindColumnTypeOption(value);
        if (option is not null) return option.SupportsAutoIncrement;
        var upper = NormalizeColumnTypeValue(value).ToUpperInvariant();
        return upper is "TINYINT" or "SMALLINT" or "MEDIUMINT" or "INT" or "INTEGER" or "BIGINT";
    }

    private string GetColumnLengthPlaceholder(SqlColumnEditDto column)
    {
        var option = FindColumnTypeOption(column.DataType);
        if (option is not null && !string.IsNullOrWhiteSpace(option.DefaultLength)) return option.DefaultLength;
        return ColumnTypeSupportsLength(column.DataType) ? "255 hoặc 10,2" : "không cần length";
    }

    private string GetColumnTypeHint(string? value)
    {
        var option = FindColumnTypeOption(value);
        if (option is not null && !string.IsNullOrWhiteSpace(option.Hint)) return option.Hint;
        return ColumnTypeSupportsLength(value) ? "Kiểu này có thể nhập length/precision." : "Kiểu này thường không dùng length.";
    }

    private static string NormalizeColumnTypeValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var text = value.Trim();
        var index = text.IndexOf('(');
        return index >= 0 ? text[..index].Trim() : text;
    }

    private static SqlColumnTypeOption TypeOption(string value, string label, string category, string defaultLength = "", string hint = "", bool length = false, bool auto = false)
        => new() { Value = value, Label = label, Category = category, DefaultLength = defaultLength, Hint = hint, SupportsLength = length, SupportsAutoIncrement = auto };

