    private async Task SaveProfileAsync()
    {
        if (Hub is null || EditingProfile is null) return;
        Busy = true;
        try
        {
            var savedId = EditingProfile.Id;
            SelectedProfile = CloneProfile(EditingProfile);
            var result = await Hub.InvokeAsync<SqlActionResultDto>("SaveSqlProfileAsync", EditingProfile);
            if (!result.Success) { StatusError(result.Message); return; }

            StatusOk(result.Message);
            CloseProfileModal();
            await LoadProfilesAsync(true);
            var savedProfile = Profiles.FirstOrDefault(x => string.Equals(x.Id, savedId, StringComparison.OrdinalIgnoreCase));
            if (savedProfile is not null)
            {
                await SelectProfileAsync(savedProfile);
            }
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

