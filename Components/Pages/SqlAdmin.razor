                    {
                        <div class="ct-pane-head mb-2">
                            <strong><i class="fa-duotone fa-solid fa-layer-plus"></i> Bulk create database</strong>
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddBulkDatabaseBlock"><i class="fa-duotone fa-solid fa-plus"></i> Thêm block</button>
                        </div>
                        <div class="ct-sql-block-list">
                            @foreach (var db in BulkDatabaseForms)
                            {
                                <div class="ct-sql-block" @key="db">
