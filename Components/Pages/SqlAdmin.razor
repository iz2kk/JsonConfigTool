    }
    private void OpenRenameTable() { if (SelectedTable is null) return; TableModalMode = "rename"; TableModalTitle = "Sửa / đổi tên bảng"; TableForm = BuildCurrentTableForm(); TableForm.NewTableName = SelectedTable.Name; ShowTableModal = true; }
    private void OpenDropTable() { if (SelectedTable is null) return; TableModalMode = "drop"; TableModalTitle = "Xóa bảng"; TableForm = BuildCurrentTableForm(); ShowTableModal = true; }
    private SqlTableCrudRequest BuildCurrentTableForm() => new() { ProfileId = SelectedProfile?.Id ?? string.Empty, DatabaseName = SelectedDatabase ?? string.Empty, Schema = SelectedTable?.Schema ?? string.Empty, TableName = SelectedTable?.Name ?? string.Empty, Columns = Columns.Select(ToEditColumn).ToList() };
    private void AddTableColumnBlock() => TableForm.Columns.Add(CreateDefaultColumn("new_column"));
    private void RemoveTableColumnBlock(SqlColumnEditDto column) => TableForm.Columns.Remove(column);

    private SqlColumnEditDto CreateDefaultColumn(string name)
    {
        var type = GetDefaultColumnType();
        var option = FindColumnTypeOption(type);
        return new SqlColumnEditDto
        {
            Name = name,
            DataType = type,
            Length = option?.DefaultLength ?? (type.Contains("char", StringComparison.OrdinalIgnoreCase) ? "255" : string.Empty),
            IsNullable = true
        };
    }

    private async Task SaveTableAsync()
    {
        if (Hub is null || SelectedProfile is null) return;
        Busy = true;
        try
        {
            TableForm.ProfileId = SelectedProfile.Id; TableForm.DatabaseName = SelectedDatabase ?? TableForm.DatabaseName;
            var method = TableModalMode == "rename" ? "RenameSqlTableAsync" : TableModalMode == "drop" ? "DropSqlTableAsync" : "CreateSqlTableAsync";
            var result = await Hub.InvokeAsync<SqlActionResultDto>(method, TableForm);
            if (result.Success) { StatusOk(result.Message); CloseModals(); await LoadTablesAsync(); } else StatusError(result.Message);
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private void OpenAddColumn() { ColumnModalMode = "add"; ColumnModalTitle = "Thêm cột"; ColumnForm = CreateDefaultColumn("new_column"); ShowColumnModal = true; }
    private void OpenEditColumn(SqlColumnDto col) { ColumnModalMode = "edit"; ColumnModalTitle = "Sửa cột"; ColumnForm = ToEditColumn(col); ShowColumnModal = true; }
    private void OpenDropColumn(SqlColumnDto col) { ColumnModalMode = "drop"; ColumnModalTitle = "Xóa cột"; ColumnForm = ToEditColumn(col); ShowColumnModal = true; }

    private async Task SaveColumnAsync()
    {
        if (Hub is null || SelectedProfile is null || SelectedTable is null || string.IsNullOrWhiteSpace(SelectedDatabase)) return;
        Busy = true;
        try
        {
            var request = new SqlColumnCrudRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable.Schema, TableName = SelectedTable.Name, Column = ColumnForm };
            var method = ColumnModalMode == "edit" ? "UpdateSqlColumnAsync" : ColumnModalMode == "drop" ? "DropSqlColumnAsync" : "AddSqlColumnAsync";
            var result = await Hub.InvokeAsync<SqlActionResultDto>(method, request);
            if (result.Success) { StatusOk(result.Message); CloseModals(); await LoadColumnsAsync(); } else StatusError(result.Message);
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private void OpenInsertRecord()
    {
        RecordModalMode = "insert"; RecordModalTitle = "Thêm record"; RecordOriginal = new(StringComparer.OrdinalIgnoreCase); RecordValues = new(StringComparer.OrdinalIgnoreCase);
        foreach (var column in Columns) RecordValues[column.Name] = null;
        ShowRecordModal = true;
    }
    private void OpenEditRecord(Dictionary<string, string?> row) { RecordModalMode = "edit"; RecordModalTitle = "Sửa record"; RecordOriginal = new(row, StringComparer.OrdinalIgnoreCase); RecordValues = new(row, StringComparer.OrdinalIgnoreCase); foreach (var column in Columns) RecordValues.TryAdd(column.Name, null); ShowRecordModal = true; }
    private void OpenDeleteRecord(Dictionary<string, string?> row) { RecordModalMode = "delete"; RecordModalTitle = "Xóa record"; RecordOriginal = new(row, StringComparer.OrdinalIgnoreCase); RecordValues = new(row, StringComparer.OrdinalIgnoreCase); ShowRecordModal = true; }
    private string? GetRecordValue(string name) => RecordValues.TryGetValue(name, out var value) ? value : null;
    private void SetRecordValue(string name, string? value) => RecordValues[name] = value;

    private async Task SaveRecordAsync()
    {
        if (Hub is null || SelectedProfile is null || SelectedTable is null || string.IsNullOrWhiteSpace(SelectedDatabase)) return;
        Busy = true;
        try
        {
            var keyColumns = Columns.Where(x => x.IsPrimaryKey).Select(x => x.Name).ToList();
            SqlActionResultDto result;
            if (RecordModalMode == "delete")
            {
                result = await Hub.InvokeAsync<SqlActionResultDto>("DeleteSqlRecordAsync", new SqlRecordDeleteRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable.Schema, TableName = SelectedTable.Name, OriginalValues = RecordOriginal, KeyColumns = keyColumns });
            }
            else
            {
                var request = new SqlRecordWriteRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable.Schema, TableName = SelectedTable.Name, OriginalValues = RecordOriginal, Values = RecordValues, KeyColumns = keyColumns };
                result = await Hub.InvokeAsync<SqlActionResultDto>(RecordModalMode == "insert" ? "InsertSqlRecordAsync" : "UpdateSqlRecordAsync", request);
            }
            if (result.Success) { StatusOk(result.Message); CloseModals(); await LoadRecordsAsync(); } else StatusError(result.Message);
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

