    private RenderFragment RenderRecordInput(Dictionary<string, string?> row, SqlColumnDto column, bool disabled) => @<div>
        @{
            var inputType = GetRecordInputType(column);
            var value = FormatRecordValueForInput(column, GetRecordValue(row, column.Name));
            var step = inputType is "datetime-local" or "time" ? "1" : null;
        }
        @if (inputType == "textarea")
        {
            <textarea class="form-control" rows="2" disabled="@disabled" value="@value" @oninput="args => SetRecordValue(row, column.Name, args.Value?.ToString())"></textarea>
        }
        else
        {
            <input class="form-control" type="@inputType" step="@step" disabled="@disabled" value="@value" @oninput="args => SetRecordValue(row, column.Name, NormalizeRecordInputValue(column, args.Value?.ToString()))" />
        }
    </div>;

