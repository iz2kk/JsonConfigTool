                                    </div>
                                    @RenderDatabaseCreateForm(db)
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ct-sql-block-list">
                            <div class="ct-sql-block">
                                <div class="ct-sql-block-head"><strong>Database block</strong><span class="badge text-bg-light border">@DatabaseModalMode</span></div>
                                @RenderDatabaseCreateForm(DatabaseForm)
                                @if (DatabaseModalMode == "rename")
                                {
                                    <div class="ct-form-block mt-3"><label class="form-label">Tên mới</label><input class="form-control" @bind="DatabaseForm.NewDatabaseName" /></div>
                                }
                                @if (DatabaseModalMode == "drop")
                                {
                                    <div class="alert alert-warning mt-3"><i class="fa-duotone fa-solid fa-triangle-exclamation"></i> Thao tác xóa database rất nguy hiểm. Hãy export trước nếu cần.</div>
