    private void InsertContextRecordWhere()
    {
        if (ContextRecord is null) return;
        var keyParts = Columns.Where(x => x.IsPrimaryKey && ContextRecord.ContainsKey(x.Name))
            .Select(x => $"{QuoteSqlIdentifier(x.Name)} = {FormatSqlLiteral(ContextRecord[x.Name])}")
            .ToList();
        if (keyParts.Count == 0)
        {
            keyParts = ContextRecord.Take(3).Select(x => $"{QuoteSqlIdentifier(x.Key)} = {FormatSqlLiteral(x.Value)}").ToList();
        }
        InsertTokenIntoQuery("WHERE " + string.Join(" AND ", keyParts));
        CloseSqlContextMenu();
    }

