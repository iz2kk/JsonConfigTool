    private async Task SaveRecordAsync()
    {
        if (Hub is null || SelectedProfile is null || SelectedTable is null || string.IsNullOrWhiteSpace(SelectedDatabase)) return;
        Busy = true;
        try
        {
            var keyColumns = Columns.Where(x => x.IsPrimaryKey).Select(x => x.Name).ToList();
            if (RecordModalMode == "bulk-insert")
            {
                var ok = 0;
                var errors = new List<string>();
                foreach (var row in BulkRecordRows)
                {
                    var request = new SqlRecordWriteRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable.Schema, TableName = SelectedTable.Name, OriginalValues = new(StringComparer.OrdinalIgnoreCase), Values = NormalizeRecordValuesForSave(row), KeyColumns = keyColumns };
                    var result = await Hub.InvokeAsync<SqlActionResultDto>("InsertSqlRecordAsync", request);
                    if (result.Success) ok++; else errors.Add(result.Message);
                }

                if (errors.Count == 0) { StatusOk($"Đã insert {ok} record."); CloseModals(); await LoadRecordsAsync(); }
                else StatusError($"Insert được {ok} record, lỗi {errors.Count}: " + string.Join(" | ", errors.Take(5)));
                return;
            }

            SqlActionResultDto single;
            if (RecordModalMode == "delete")
            {
                single = await Hub.InvokeAsync<SqlActionResultDto>("DeleteSqlRecordAsync", new SqlRecordDeleteRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable.Schema, TableName = SelectedTable.Name, OriginalValues = RecordOriginal, KeyColumns = keyColumns });
            }
            else
            {
                var request = new SqlRecordWriteRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable.Schema, TableName = SelectedTable.Name, OriginalValues = RecordOriginal, Values = NormalizeRecordValuesForSave(RecordValues), KeyColumns = keyColumns };
                single = await Hub.InvokeAsync<SqlActionResultDto>(RecordModalMode == "insert" ? "InsertSqlRecordAsync" : "UpdateSqlRecordAsync", request);
            }
            if (single.Success) { StatusOk(single.Message); CloseModals(); await LoadRecordsAsync(); } else StatusError(single.Message);
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private async Task BulkDeleteSelectedRecordsAsync()
    {
        if (Hub is null || SelectedProfile is null || SelectedTable is null || string.IsNullOrWhiteSpace(SelectedDatabase) || SelectedRecordRows.Count == 0) return;
        if (!await ConfirmAsync($"Xóa {SelectedRecordRows.Count} record đã tick trong bảng {SelectedTable.FullName}?")) return;
        Busy = true;
        try
        {
            var keyColumns = Columns.Where(x => x.IsPrimaryKey).Select(x => x.Name).ToList();
            var rows = SelectedRecordRows.Values.Select(x => new Dictionary<string, string?>(x, StringComparer.OrdinalIgnoreCase)).ToList();
            var ok = 0;
            var errors = new List<string>();
            foreach (var row in rows)
            {
                var result = await Hub.InvokeAsync<SqlActionResultDto>("DeleteSqlRecordAsync", new SqlRecordDeleteRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable.Schema, TableName = SelectedTable.Name, OriginalValues = NormalizeRecordValuesForSave(row), KeyColumns = keyColumns });
                if (result.Success) ok++; else errors.Add(result.Message);
            }

            ClearSelectedRecords();
            if (errors.Count == 0) StatusOk($"Đã xóa {ok} record đã tick.");
            else StatusError($"Xóa được {ok} record, lỗi {errors.Count}: " + string.Join(" | ", errors.Take(5)));
            await LoadRecordsAsync();
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

