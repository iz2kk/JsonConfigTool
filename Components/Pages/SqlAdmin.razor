                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseModals">Hủy</button>
                    <button class="btn btn-primary" disabled="@Busy" @onclick="SaveDatabaseAsync"><i class="fa-duotone fa-solid fa-floppy-disk"></i> Thực hiện</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
