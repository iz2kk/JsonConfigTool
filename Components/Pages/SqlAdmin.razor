                else
                {
                    <tr><td colspan="@(Math.Max(1, QueryCrudColumns.Count + (CanCrudQueryResult ? 1 : 0)))"><div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có dữ liệu.</div></td></tr>
                }
            </tbody>
        </table>
    </div>;

    private string FormatTableIdentifier(SqlTableDto table)
    {
        var isSqlServer = IsSelectedSqlServer();
        if (isSqlServer && !string.IsNullOrWhiteSpace(table.Schema)) return $"{QuoteSqlIdentifier(table.Schema)}.{QuoteSqlIdentifier(table.Name)}";
        return QuoteSqlIdentifier(table.Name);
    }

    private string QuoteSqlIdentifier(string identifier)
    {
        if (string.IsNullOrWhiteSpace(identifier)) return identifier;
        return IsSelectedSqlServer()
            ? "[" + identifier.Replace("]", "]]", StringComparison.Ordinal) + "]"
            : "`" + identifier.Replace("`", "``", StringComparison.Ordinal) + "`";
    }

    private bool IsSelectedSqlServer() => SqlConnectConfigService.NormalizeType(SelectedProfile?.TypeConnect ?? EditingProfile?.TypeConnect) == "sqlserver";

    private string BuildDefaultLimitClause() => IsSelectedSqlServer() ? string.Empty : $"LIMIT {Math.Clamp(QueryMaxRows, 1, 5000)}";

    private async Task RunQueryAsync()
    {
        if (Hub is null || SelectedProfile is null) return;
        Busy = true;
        try
        {
            var request = new SqlQueryRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase ?? EditingProfile?.Database ?? string.Empty, QueryText = QueryText, MaxRows = QueryMaxRows };
            QueryResult = await Hub.InvokeAsync<SqlQueryResultDto>("ExecuteSqlQueryAsync", request);
            BuildQueryEditableRowsFromResult();
            if (QueryResult.Success) StatusOk(QueryResult.Message); else StatusError(QueryResult.Message);
            if (QueryResult.Success && !LooksLikeSelect(QueryText)) await ReloadSelectedSqlAsync();
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private async Task RunExportAsync()
    {
        if (Hub is null || SelectedProfile is null || string.IsNullOrWhiteSpace(SelectedDatabase)) return;
        Busy = true;
        try
        {
            var result = await Hub.InvokeAsync<SqlQueryResultDto>("ExportSqlScriptAsync", new SqlExportRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase, Schema = SelectedTable?.Schema ?? string.Empty, TableName = SelectedTable?.Name ?? string.Empty, IncludeStructure = ExportStructure, IncludeData = ExportData, MaxRows = ExportMaxRows });
            if (result.Success)
            {
                ExportText = result.Rows.FirstOrDefault()?.Values.FirstOrDefault() ?? string.Empty;
                StatusOk(result.Message);
            }
            else StatusError(result.Message);
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private async Task RunImportAsync()
    {
        if (Hub is null || SelectedProfile is null) return;
        Busy = true;
        try
        {
            var result = await Hub.InvokeAsync<SqlQueryResultDto>("ImportSqlScriptAsync", new SqlImportRequest { ProfileId = SelectedProfile.Id, DatabaseName = SelectedDatabase ?? EditingProfile?.Database ?? string.Empty, ScriptText = ImportText });
            if (result.Success) { StatusOk(result.Message); await ReloadSelectedSqlAsync(); } else StatusError(result.Message);
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private async Task OnTableSearchInputAsync(ChangeEventArgs args) { TableSearch = args.Value?.ToString() ?? string.Empty; await DebounceAsync(LoadTablesAsync); }
    private async Task OnRecordSearchInputAsync(ChangeEventArgs args) { RecordSearch = args.Value?.ToString() ?? string.Empty; RecordPageNumber = 1; await DebounceAsync(LoadRecordsAsync); }
    private async Task DebounceAsync(Func<Task> action)
    {
        SearchDebounce?.Cancel(); SearchDebounce?.Dispose(); SearchDebounce = new CancellationTokenSource(); var token = SearchDebounce.Token;
        try { await Task.Delay(300, token); await action(); await InvokeAsync(StateHasChanged); } catch (OperationCanceledException) { }
    }
    private async Task OnRecordPageSizeChangedAsync(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var size)) { RecordPageSize = size; RecordPageNumber = 1; await LoadRecordsAsync(); } }
    private async Task ChangeRecordPageAsync(int page) { RecordPageNumber = page; await LoadRecordsAsync(); }
    private async Task SetSqlTab(string tab) { SqlTab = tab; if (tab == "records" && RecordPage is null) await LoadRecordsAsync(); if (tab == "query" && QueryTemplates.Count == 0) await LoadTemplatesAsync(); }

    private void OpenCreateDatabase() { DatabaseModalMode = "create"; DatabaseModalTitle = "Tạo database"; DatabaseForm = new SqlDatabaseCrudRequest { ProfileId = SelectedProfile?.Id ?? string.Empty, Charset = "utf8mb4", Collation = "utf8mb4_unicode_ci" }; ShowDatabaseModal = true; }
    private void OpenRenameDatabase() { DatabaseModalMode = "rename"; DatabaseModalTitle = "Sửa / đổi tên database"; DatabaseForm = new SqlDatabaseCrudRequest { ProfileId = SelectedProfile?.Id ?? string.Empty, DatabaseName = SelectedDatabase ?? string.Empty, NewDatabaseName = SelectedDatabase ?? string.Empty }; ShowDatabaseModal = true; }
    private void OpenDropDatabase() { DatabaseModalMode = "drop"; DatabaseModalTitle = "Xóa database"; DatabaseForm = new SqlDatabaseCrudRequest { ProfileId = SelectedProfile?.Id ?? string.Empty, DatabaseName = SelectedDatabase ?? string.Empty }; ShowDatabaseModal = true; }

    private async Task SaveDatabaseAsync()
    {
        if (Hub is null || SelectedProfile is null) return;
        Busy = true;
        try
        {
            DatabaseForm.ProfileId = SelectedProfile.Id;
            var method = DatabaseModalMode == "rename" ? "RenameSqlDatabaseAsync" : DatabaseModalMode == "drop" ? "DropSqlDatabaseAsync" : "CreateSqlDatabaseAsync";
            var result = await Hub.InvokeAsync<SqlActionResultDto>(method, DatabaseForm);
            if (result.Success) { StatusOk(result.Message); CloseModals(); await LoadDatabasesAsync(); } else StatusError(result.Message);
        }
        catch (Exception ex) { StatusError(ex.Message); }
        finally { Busy = false; }
    }

    private void OpenCreateTable()
    {
        TableModalMode = "create"; TableModalTitle = "Tạo bảng";
        var nameColumn = CreateDefaultColumn("name");
        TableForm = new SqlTableCrudRequest
        {
            ProfileId = SelectedProfile?.Id ?? string.Empty,
            DatabaseName = SelectedDatabase ?? string.Empty,
            Schema = SelectedTable?.Schema ?? string.Empty,
            TableName = "new_table",
            Columns =
            [
                new SqlColumnEditDto { Name = "id", DataType = "int", IsNullable = false, IsPrimaryKey = true, AutoIncrement = true },
                nameColumn
            ]
        };
