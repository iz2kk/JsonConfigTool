    private async Task AddCommitPushAsync()
    {
        await RunUiAsync("Đang Add → Commit → Push...", async () =>
        {
            var hub = RequireHub();
            var addResult = await hub.InvokeAsync<GitActionResultDto>("AddGitFilesAsync", new GitAddRequestDto
            {
                FolderPath = ProjectFolder,
                StageAll = SelectedGitPaths.Count == 0,
                Paths = SelectedGitPaths.ToList()
            });
            if (!addResult.Success)
            {
                Repository = addResult.Repository ?? Repository;
                SetStatus(addResult.Message, true);
                return;
            }

            var commitResult = await hub.InvokeAsync<GitActionResultDto>("CommitGitAsync", new GitCommitRequestDto
            {
                FolderPath = ProjectFolder,
                Message = CommitMessage,
                StageAll = false
            });
            if (!commitResult.Success)
            {
                Repository = commitResult.Repository ?? addResult.Repository ?? Repository;
                SetStatus(commitResult.Message, true);
                return;
            }

            var pushResult = await hub.InvokeAsync<GitActionResultDto>("PushGitAsync", new GitPushPullRequestDto
            {
                FolderPath = ProjectFolder,
                RemoteName = PushRemote,
                BranchName = PushBranch,
                SetUpstream = true
            });
            Repository = pushResult.Repository ?? commitResult.Repository ?? addResult.Repository;
            SetStatus(pushResult.Message, !pushResult.Success);
            await LoadFileExplorerCoreAsync();
        });
    }

