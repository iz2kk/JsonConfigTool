    private bool AreAllVisibleFilesSelected => ExplorerData?.Items.Any(x => x.CanStage) == true && ExplorerData.Items.Where(x => x.CanStage).All(x => SelectedGitPaths.Contains(x.RelativePath));
    private const int AccountsPageSize = 8;
    private int AccountPage = 1;
    private List<GitAccountDto> FilteredAccounts => FilterGitAccounts().ToList();
    private int AccountTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAccounts.Count / (double)AccountsPageSize));
    private IEnumerable<GitAccountDto> PagedAccounts => FilteredAccounts.Skip((Math.Clamp(AccountPage, 1, AccountTotalPages) - 1) * AccountsPageSize).Take(AccountsPageSize);
    private IEnumerable<GitBranchDto> FilteredRepositoryBranches => FilterBranches();
    private List<GitProjectConfigFileDto> FilteredGitConfigFiles => FilterGitConfigFiles().ToList();
    private List<GitWorkspaceDto> FilteredWorkspaces => FilterWorkspaces().ToList();
    private List<GitConsoleEntryDto> FilteredLogs => FilterLogs().ToList();

    protected override async Task OnInitializedAsync()
    {
        await SignalRHost.EnsureStartedAsync();
        Hub = new HubConnectionBuilder()
            .WithUrl(SignalRHost.HubUrl)
            .WithAutomaticReconnect()
            .Build();

        Hub.On<GitConsoleEntryDto>("GitConsoleEntry", entry =>
        {
            if (_disposed)
            {
                return Task.CompletedTask;
            }

            AddLog(entry);
            return SafeStateHasChangedAsync();
        });
        Hub.On<string>("GitConfigChanged", async _ =>
        {
            if (_disposed)
            {
                return;
            }

            try
            {
                await ReloadConfigAsync();
                await SafeStateHasChangedAsync();
            }
            catch (OperationCanceledException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        });

        try
        {
            await Hub.StartAsync();
            if (_disposed)
            {
                return;
            }

            HubReady = true;
            await ReloadAllAsync();
        }
        catch (OperationCanceledException)
        {
            HubReady = false;
        }
        catch (ObjectDisposedException)
        {
            HubReady = false;
        }
        catch (Exception ex)
        {
            HubReady = false;
            SetStatus("Không khởi động được Git hub: " + ex.Message, true);
        }
    }

    private async Task ReloadAllAsync()
    {
        await RunUiAsync("Đang tải Git config...", async () =>
        {
            await ReloadConfigAsync();
            await LoadOAuth2SettingsCoreAsync();
            await LoadWorkspacesCoreAsync();
            if (!string.IsNullOrWhiteSpace(ProjectFolder))
            {
                await RefreshRepositoryCoreAsync();
                await LoadFileExplorerCoreAsync();
            }
        });
    }

    private async Task ReloadConfigAsync()
    {
        var hub = RequireHub();
        var response = await hub.InvokeAsync<GitConfigResponseDto>("GetGitConfigAsync");
        GitConfigPath = response.ConfigFilePath;
        Accounts = response.Config.Accounts.OrderByDescending(x => x.IsDefault).ThenBy(x => x.Provider).ThenBy(x => x.Name).ToList();
        ClampAccountPage();
        if (SelectedAccountId is not null && Accounts.All(x => x.Id != SelectedAccountId))
        {
            SelectedAccountId = null;
        }
        SelectedGitAccountIds.RemoveWhere(id => Accounts.All(x => !string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase)));
        SelectedAccountId ??= Accounts.FirstOrDefault(x => x.IsDefault)?.Id ?? Accounts.FirstOrDefault()?.Id;
        CreateRepoAccountId = string.IsNullOrWhiteSpace(CreateRepoAccountId) ? SelectedAccountId ?? string.Empty : CreateRepoAccountId;
        RepoListAccountId = string.IsNullOrWhiteSpace(RepoListAccountId) ? SelectedAccountId ?? string.Empty : RepoListAccountId;
        ProjectFolder = string.IsNullOrWhiteSpace(ProjectFolder) ? response.Config.LastProjectFolder ?? string.Empty : ProjectFolder;
        CloneParentFolder = string.IsNullOrWhiteSpace(CloneParentFolder) ? response.Config.LastCloneFolder ?? string.Empty : CloneParentFolder;
        ScanRootFolder = string.IsNullOrWhiteSpace(ScanRootFolder) ? ProjectFolder : ScanRootFolder;
    }

    private async Task PickProjectFolderAsync()
    {
        try
        {
            var folder = await FolderPicker.PickFolderAsync("Chọn thư mục dự án Git", "Chọn project");
            if (!string.IsNullOrWhiteSpace(folder))
            {
                ProjectFolder = folder;
                await UseProjectFolderAsync();
            }
        }
        catch (Exception ex)
        {
            SetStatus("Không mở được folder dialog: " + ex.Message, true);
        }
    }

    private async Task UseProjectFolderAsync()
    {
        await RunUiAsync("Đang chọn project...", async () =>
        {
            var hub = RequireHub();
            await hub.InvokeAsync<GitActionResultDto>("SaveGitProjectFolderAsync", ProjectFolder);
            await RefreshRepositoryCoreAsync();
            await LoadGitIgnoreCoreAsync();
            await LoadFileExplorerCoreAsync();
            await LoadGitConfigFilesCoreAsync();
            ScanRootFolder = ProjectFolder;
        });
    }

    private async Task OpenProjectFolderAsync()
    {
        var result = await Explorer.OpenFolderAsync(ProjectFolder);
        SetStatus(result.Message, !result.Success);
    }

    private void SelectAccount(GitAccountDto account)
    {
        SelectedAccountId = account.Id;
        CreateRepoAccountId = account.Id;
        RepoListAccountId = account.Id;
    }

    private void ToggleGitAccountSelection(string accountId, ChangeEventArgs args)
    {
        var selected = args.Value is bool b ? b : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        if (selected)
        {
            SelectedGitAccountIds.Add(accountId);
        }
        else
        {
            SelectedGitAccountIds.Remove(accountId);
        }
    }

    private void SelectVisibleGitAccounts()
    {
        foreach (var account in PagedAccounts)
        {
            SelectedGitAccountIds.Add(account.Id);
        }
    }

    private void SelectAllGitAccounts()
    {
        foreach (var account in Accounts)
        {
            SelectedGitAccountIds.Add(account.Id);
        }
    }

    private void ClearSelectedGitAccounts()
    {
        SelectedGitAccountIds.Clear();
    }

    private List<string> GetRepoActionAccountIds()
    {
        if (SelectedGitAccountIds.Count > 0)
        {
            return SelectedGitAccountIds.ToList();
        }

        return string.IsNullOrWhiteSpace(RepoListAccountId) ? [] : [RepoListAccountId];
    }

    private void OpenCreateAccountModal()
    {
        EditingAccountId = null;
        AccountForm = NewAccount();
        AccountForm.OAuthRedirectPort = OAuth2Settings.CallbackPort <= 0 ? 53682 : OAuth2Settings.CallbackPort;
        ShowAccountModal = true;
    }

    private void EditAccount(GitAccountDto account)
    {
        EditingAccountId = account.Id;
        AccountForm = CloneAccount(account);
        ShowAccountModal = true;
    }

    private void CloseAccountModal()
    {
        if (Busy)
        {
            return;
        }

        ShowAccountModal = false;
    }

    private async Task SaveAccountAsync()
    {
        await RunUiAsync("Đang lưu account...", async () =>
        {
            var hub = RequireHub();
            if (string.IsNullOrWhiteSpace(EditingAccountId) && string.IsNullOrWhiteSpace(AccountForm.Id))
            {
                AccountForm.Id = Guid.NewGuid().ToString("N");
            }

            var result = await hub.InvokeAsync<GitActionResultDto>("SaveGitAccountAsync", AccountForm);
            SetStatus(result.Message, !result.Success);
            if (result.Success)
            {
                SelectedAccountId = AccountForm.Id;
                ResetAccountForm();
                ShowAccountModal = false;
                await ReloadConfigAsync();
            }
        }, "account");
    }

    private async Task DeleteAccountAsync(GitAccountDto account)
    {
        await RunUiAsync("Đang xóa account...", async () =>
        {
            var hub = RequireHub();
            var result = await hub.InvokeAsync<GitActionResultDto>("DeleteGitAccountAsync", account.Id);
            SetStatus(result.Message, !result.Success);
            await ReloadConfigAsync();
        }, "account");
    }

    private async Task TestAccountAsync(GitAccountDto account)
    {
        await RunUiAsync("Đang test account...", async () =>
        {
            var hub = RequireHub();
            var result = await hub.InvokeAsync<GitCreatedRepositoryDto>("TestGitAccountAsync", account.Id);
            SetStatus(result.Message, !result.Success);
        }, "account");
    }

    private void ResetAccountForm()
    {
        EditingAccountId = null;
        AccountForm = NewAccount();
        AccountForm.OAuthRedirectPort = OAuth2Settings.CallbackPort <= 0 ? 53682 : OAuth2Settings.CallbackPort;
    }

    private void ResetAccountFormInModal()
    {
        if (EditingAccountId is not null)
        {
            var current = Accounts.FirstOrDefault(x => x.Id == EditingAccountId);
            if (current is not null)
            {
                AccountForm = CloneAccount(current);
                return;
            }
        }

        AccountForm = NewAccount();
    }

    private void NormalizeAccountDefaults()
    {
        if (AccountForm.Provider == "gitlab" && (string.IsNullOrWhiteSpace(AccountForm.ApiBaseUrl) || AccountForm.ApiBaseUrl.Contains("github", StringComparison.OrdinalIgnoreCase)))
        {
            AccountForm.ApiBaseUrl = "https://gitlab.com/api/v4";
        }
        else if (AccountForm.Provider == "github" && (string.IsNullOrWhiteSpace(AccountForm.ApiBaseUrl) || AccountForm.ApiBaseUrl.Contains("gitlab", StringComparison.OrdinalIgnoreCase)))
        {
            AccountForm.ApiBaseUrl = "https://api.github.com";
        }
    }


    private void PreviousAccountPage()
    {
        if (AccountPage > 1)
        {
            AccountPage--;
        }
    }

    private void NextAccountPage()
    {
        if (AccountPage < AccountTotalPages)
        {
            AccountPage++;
        }
    }

    private void ClampAccountPage()
    {
        if (AccountPage < 1)
        {
            AccountPage = 1;
        }

        if (AccountPage > AccountTotalPages)
        {
            AccountPage = AccountTotalPages;
        }
    }

    private async Task StartOAuthForAccountFormAsync()
    {
        await RunUiAsync("Đang OAuth lấy token...", async () =>
        {
            NormalizeAccountDefaults();
            if (string.IsNullOrWhiteSpace(AccountForm.Id))
            {
                AccountForm.Id = Guid.NewGuid().ToString("N");
            }

            var hub = RequireHub();
            var result = await hub.InvokeAsync<GitOAuthResultDto>("StartGitOAuthAsync", new GitOAuthRequestDto
            {
                Account = AccountForm,
                TimeoutSeconds = 300
            });
            SetStatus(result.Message, !result.Success);
            if (result.Success && result.Account is not null)
            {
                AccountForm = CloneAccount(result.Account);
                EditingAccountId = AccountForm.Id;
                SelectedAccountId = AccountForm.Id;
                await ReloadConfigAsync();
            }
        }, "account");
    }


    private async Task LoadProviderRepositoriesAsync()
        => await RunUiAsync("Đang lấy repository list...", async () => await LoadProviderRepositoriesCoreAsync(), "repositories");

    private async Task LoadProviderRepositoriesCoreAsync()
    {
        var hub = RequireHub();
        var accountIds = GetRepoActionAccountIds();
        if (accountIds.Count == 0)
        {
            SetStatus("Chưa chọn hoặc tick account để lấy repository list.", true);
            return;
        }

        if (accountIds.Count > 1)
        {
            ProviderRepositories = await hub.InvokeAsync<GitRepositoryListResponseDto>("ListGitRepositoriesForAccountsAsync", new GitBatchRepositoryListRequestDto
            {
                AccountIds = accountIds,
                Search = RepoListSearch,
                PageSize = 50,
                MaxParallel = 4
            });
        }
        else
        {
            RepoListAccountId = accountIds[0];
            ProviderRepositories = await hub.InvokeAsync<GitRepositoryListResponseDto>("ListGitRepositoriesAsync", new GitRepositoryListRequestDto
            {
                AccountId = RepoListAccountId,
                Search = RepoListSearch,
                PageSize = 50
            });
        }

        SetStatus(ProviderRepositories.Message, !ProviderRepositories.Success);
        if (ProviderRepositories.Items.Count > 0)
        {
            var first = ProviderRepositories.Items[0];
            SelectedProviderRepositoryFullName = first.FullName;
            SelectedProviderRepositoryId = first.Id;
            if (!string.IsNullOrWhiteSpace(first.AccountId))
            {
                RepoListAccountId = first.AccountId;
            }
        }
    }

    private async Task TestSelectedAccountsAsync()
    {
        await RunUiAsync("Đang test nhiều account...", async () =>
        {
            var hub = RequireHub();
            BatchResults = await hub.InvokeAsync<GitBatchAccountActionResponseDto>("TestGitAccountsAsync", new GitBatchAccountActionRequestDto
            {
                AccountIds = SelectedGitAccountIds.ToList(),
                Action = "test",
                MaxParallel = 4
            });
            SetStatus(BatchResults.Message, !BatchResults.Success);
        }, "account");
    }

    private async Task CreateRepositoryForSelectedAccountsAsync()
    {
        await RunUiAsync("Đang tạo repository trên nhiều account...", async () =>
        {
            var hub = RequireHub();
            BatchResults = await hub.InvokeAsync<GitBatchAccountActionResponseDto>("CreateGitRepositoryForAccountsAsync", new GitBatchCreateRepositoryRequestDto
            {
                AccountIds = SelectedGitAccountIds.ToList(),
                Name = CreateRepoName,
                Description = CreateRepoDescription,
                Visibility = CreateRepoVisibility,
                InitializeReadme = CreateRepoReadme,
                MaxParallel = 3
            });
            SetStatus(BatchResults.Message, !BatchResults.Success);
            await LoadProviderRepositoriesCoreAsync();
        }, "clone");
    }

    private void SelectProviderRepository(GitProviderRepositoryDto repo)
    {
        SelectedProviderRepositoryFullName = repo.FullName;
        SelectedProviderRepositoryId = repo.Id;
        if (!string.IsNullOrWhiteSpace(repo.AccountId))
        {
            RepoListAccountId = repo.AccountId;
            SelectedAccountId = repo.AccountId;
        }
        if (!string.IsNullOrWhiteSpace(repo.DefaultBranch))
        {
            PushBranch = repo.DefaultBranch;
        }

        if (!string.IsNullOrWhiteSpace(repo.CloneUrl))
        {
            CloneUrl = repo.CloneUrl;
        }
    }

    private void UseProviderRepositoryForClone(GitProviderRepositoryDto repo)
    {
        SelectProviderRepository(repo);
        CloneUrl = repo.CloneUrl;
        CloneTargetName = repo.Name;
        ActiveTab = "clone";
        SetStatus("Đã đưa repository vào form Clone: " + repo.FullName, false);
    }

    private void UseProviderRepositoryAsRemote(GitProviderRepositoryDto repo)
    {
        SelectProviderRepository(repo);
        RemoteName = "origin";
        PushRemote = "origin";
        RemoteUrl = repo.CloneUrl;
        PushBranch = string.IsNullOrWhiteSpace(repo.DefaultBranch) ? PushBranch : repo.DefaultBranch;
        ActiveTab = "commands";
        SetStatus("Đã đưa repository vào remote URL: " + repo.FullName, false);
    }

    private async Task LoadTrafficForRepositoryAsync(GitProviderRepositoryDto repo)
    {
        SelectProviderRepository(repo);
        ActiveTab = "traffic";
        await LoadTrafficForSelectedRepoAsync();
    }

    private async Task LoadTrafficForSelectedRepoAsync()
        => await RunUiAsync("Đang lấy repository traffic...", async () => await LoadTrafficForSelectedRepoCoreAsync(), "traffic");

    private async Task LoadTrafficForSelectedRepoCoreAsync()
    {
        if (string.IsNullOrWhiteSpace(RepoListAccountId))
        {
            RepoListAccountId = SelectedAccountId ?? string.Empty;
        }

        var hub = RequireHub();
        TrafficStats = await hub.InvokeAsync<GitTrafficStatsDto>("GetGitRepositoryTrafficAsync", new GitTrafficRequestDto
        {
            AccountId = RepoListAccountId,
            RepositoryFullName = SelectedProviderRepositoryFullName ?? string.Empty,
            RepositoryId = SelectedProviderRepositoryId ?? string.Empty
        });
        SetStatus(TrafficStats.Message, !TrafficStats.Success);
    }

    private async Task LoadGitConfigFilesAsync()
        => await RunUiAsync("Đang đọc .git/.github config...", async () => await LoadGitConfigFilesCoreAsync(), "config");

    private async Task LoadGitConfigFilesCoreAsync()
    {
        if (string.IsNullOrWhiteSpace(ProjectFolder))
        {
            GitConfigFiles = null;
            SelectedGitConfigPath = null;
            return;
        }

        var hub = RequireHub();
        GitConfigFiles = await hub.InvokeAsync<GitProjectConfigSnapshotDto>("GetGitProjectConfigFilesAsync", ProjectFolder);
        if (GitConfigFiles.Files.Count == 0)
        {
            SelectedGitConfigPath = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(SelectedGitConfigPath) || GitConfigFiles.Files.All(x => x.RelativePath != SelectedGitConfigPath))
        {
            SelectedGitConfigPath = GitConfigFiles.Files[0].RelativePath;
        }
    }

    private void SelectGitConfigFile(GitProjectConfigFileDto file)
    {
        SelectedGitConfigPath = file.RelativePath;
    }

    private async Task RefreshRepositoryAsync()
        => await RunUiAsync("Đang refresh repository...", async () => await RefreshRepositoryCoreAsync(), "commands");

    private async Task RefreshRepositoryCoreAsync()
    {
        if (string.IsNullOrWhiteSpace(ProjectFolder))
        {
            return;
        }

        var hub = RequireHub();
        Repository = await hub.InvokeAsync<GitRepositoryStatusDto>("GetGitRepositoryStatusAsync", ProjectFolder);
        if (string.IsNullOrWhiteSpace(PushBranch))
        {
            PushBranch = Repository.CurrentBranch;
        }
    }

    private async Task GitInitAsync()
    {
        await RunGitActionAsync("Đang git init...", async hub => await hub.InvokeAsync<GitActionResultDto>("GitInitAsync", ProjectFolder));
    }

    private async Task AddRemoteAsync()
    {
        await RunGitActionAsync("Đang thêm remote...", async hub => await hub.InvokeAsync<GitActionResultDto>("AddGitRemoteAsync", new GitRemoteRequestDto
        {
            FolderPath = ProjectFolder,
            RemoteName = RemoteName,
            RemoteUrl = RemoteUrl,
            SetUrlIfExists = true
        }));
    }

    private async Task AddSelectedFilesAsync()
    {
        await RunGitActionAsync("Đang git add selected...", async hub => await hub.InvokeAsync<GitActionResultDto>("AddGitFilesAsync", new GitAddRequestDto
        {
            FolderPath = ProjectFolder,
            StageAll = false,
            Paths = SelectedGitPaths.ToList()
        }));
    }

    private async Task AddAllFilesAsync()
    {
        await RunGitActionAsync("Đang git add all...", async hub => await hub.InvokeAsync<GitActionResultDto>("AddGitFilesAsync", new GitAddRequestDto
        {
            FolderPath = ProjectFolder,
            StageAll = true
        }));
    }

    private async Task AddCommitPushAsync()
    {
        await RunUiAsync("Đang Add → Commit → Push...", async () =>
        {
            var hub = RequireHub();
            var addResult = await hub.InvokeAsync<GitActionResultDto>("AddGitFilesAsync", new GitAddRequestDto
            {
                FolderPath = ProjectFolder,
                StageAll = SelectedGitPaths.Count == 0,
                Paths = SelectedGitPaths.ToList()
            });
            if (!addResult.Success)
            {
                Repository = addResult.Repository ?? Repository;
                SetStatus(addResult.Message, true);
                return;
            }

            var commitResult = await hub.InvokeAsync<GitActionResultDto>("CommitGitAsync", new GitCommitRequestDto
            {
                FolderPath = ProjectFolder,
                Message = CommitMessage,
                StageAll = false
            });
            if (!commitResult.Success)
            {
                Repository = commitResult.Repository ?? addResult.Repository ?? Repository;
                SetStatus(commitResult.Message, true);
                return;
            }

            var pushResult = await hub.InvokeAsync<GitActionResultDto>("PushGitAsync", new GitPushPullRequestDto
            {
                FolderPath = ProjectFolder,
                RemoteName = PushRemote,
                BranchName = PushBranch,
                SetUpstream = true
            });
            Repository = pushResult.Repository ?? commitResult.Repository ?? addResult.Repository;
            SetStatus(pushResult.Message, !pushResult.Success);
            await LoadFileExplorerCoreAsync();
        });
    }

    private async Task CommitAsync()
    {
        await RunGitActionAsync("Đang commit...", async hub => await hub.InvokeAsync<GitActionResultDto>("CommitGitAsync", new GitCommitRequestDto
        {
            FolderPath = ProjectFolder,
            Message = CommitMessage,
            StageAll = StageAll,
            Paths = StageAll ? new List<string>() : SelectedGitPaths.ToList()
        }));
    }

    private async Task PushAsync()
    {
        await RunGitActionAsync("Đang push...", async hub => await hub.InvokeAsync<GitActionResultDto>("PushGitAsync", new GitPushPullRequestDto
        {
            FolderPath = ProjectFolder,
            RemoteName = string.IsNullOrWhiteSpace(PushRemote) ? "origin" : PushRemote,
            BranchName = PushBranch,
            SetUpstream = true
        }));
    }

    private async Task PullAsync()
    {
        await RunGitActionAsync("Đang pull...", async hub => await hub.InvokeAsync<GitActionResultDto>("PullGitAsync", new GitPushPullRequestDto
