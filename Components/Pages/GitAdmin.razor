    private IEnumerable<GitAccountDto> FilterGitAccounts()
    {
        var query = AccountSearch.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            return Accounts;
        }

        return Accounts.Where(account => ContainsText(account.Provider, query)
            || ContainsText(account.Name, query)
            || ContainsText(account.Username, query)
            || ContainsText(account.Email, query)
            || ContainsText(account.ApiBaseUrl, query)
            || ContainsText(account.GitBaseUrl, query));
    }

    private IEnumerable<GitBranchDto> FilterBranches()
    {
        var branches = Repository?.Branches ?? [];
        var query = BranchSearch.Trim();
        return string.IsNullOrWhiteSpace(query)
            ? branches
            : branches.Where(branch => ContainsText(branch.Name, query));
    }

    private IEnumerable<GitProjectConfigFileDto> FilterGitConfigFiles()
    {
        var files = GitConfigFiles?.Files ?? [];
        var query = GitConfigSearch.Trim();
        return string.IsNullOrWhiteSpace(query)
            ? files
            : files.Where(file => ContainsText(file.Source, query)
                || ContainsText(file.DisplayName, query)
                || ContainsText(file.RelativePath, query)
                || ContainsText(file.FullPath, query)
                || ContainsText(file.Content, query));
    }

    private IEnumerable<GitWorkspaceDto> FilterWorkspaces()
    {
        var query = WorkspaceSearch.Trim();
        return string.IsNullOrWhiteSpace(query)
            ? Workspaces
            : Workspaces.Where(ws => ContainsText(ws.Provider, query)
                || ContainsText(ws.AccountName, query)
                || ContainsText(ws.RepositoryFullName, query)
                || ContainsText(ws.RepositoryId, query)
                || ContainsText(ws.BranchName, query)
                || ContainsText(ws.RemoteName, query)
                || ContainsText(ws.FolderPath, query)
                || ContainsText(ws.CloneUrl, query));
    }

    private IEnumerable<GitConsoleEntryDto> FilterLogs()
    {
        var query = ConsoleSearch.Trim();
        return string.IsNullOrWhiteSpace(query)
            ? Logs
            : Logs.Where(log => ContainsText(log.Level, query)
                || ContainsText(log.Scope, query)
                || ContainsText(log.Message, query)
                || log.Time.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss").Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private static bool ContainsText(string? source, string query)
        => !string.IsNullOrWhiteSpace(source) && source.Contains(query, StringComparison.OrdinalIgnoreCase);

