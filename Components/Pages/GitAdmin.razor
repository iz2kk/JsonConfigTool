    private async Task RunGitActionAsync(string busyText, Func<HubConnection, Task<GitActionResultDto>> action, bool useReturnedRepositoryFolder = false)
    {
        await RunUiAsync(busyText, async () =>
        {
            var hub = RequireHub();
            var result = await action(hub);
            SetStatus(result.Message, !result.Success);
            if (useReturnedRepositoryFolder && result.Repository is not null && !string.IsNullOrWhiteSpace(result.Repository.FolderPath))
            {
                ProjectFolder = result.Repository.FolderPath;
            }
            Repository = result.Repository ?? (string.IsNullOrWhiteSpace(ProjectFolder) ? null : await hub.InvokeAsync<GitRepositoryStatusDto>("GetGitRepositoryStatusAsync", ProjectFolder));
            await LoadFileExplorerCoreAsync();
        });
    }

    private async Task RunUiAsync(string busyText, Func<Task> action, string? operationScope = null)
    {
        Busy = true;
        CancelRequested = false;
        CurrentBusyScope = operationScope ?? ActiveTab;
        BusyText = busyText;
        try
        {
            await action();
        }
        catch (OperationCanceledException)
        {
            SetStatus("Đã hủy hành động.", false);
            AddLog(new GitConsoleEntryDto { Level = "warn", Scope = "cancel", Message = "Đã hủy hành động." });
        }
        catch (Exception ex)
        {
            var canceled = CancelRequested || ex.Message.Contains("cancel", StringComparison.OrdinalIgnoreCase) || ex.Message.Contains("hủy", StringComparison.OrdinalIgnoreCase);
            SetStatus(canceled ? "Đã gửi lệnh hủy hành động." : ex.Message, !canceled);
            AddLog(new GitConsoleEntryDto { Level = canceled ? "warn" : "error", Scope = canceled ? "cancel" : "ui", Message = canceled ? "Đã gửi lệnh hủy hành động." : ex.Message });
        }
        finally
        {
            Busy = false;
            CancelRequested = false;
            CurrentBusyScope = null;
            BusyText = null;
        }
    }

    private HubConnection RequireHub()
        => Hub ?? throw new InvalidOperationException("SignalR Git hub chưa sẵn sàng.");

    private void AddLog(GitConsoleEntryDto entry)
    {
        Logs.Insert(0, entry);
        if (Logs.Count > 500)
        {
            Logs.RemoveRange(500, Logs.Count - 500);
        }
    }

