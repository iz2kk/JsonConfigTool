        RefreshToken = account.RefreshToken,
        TokenExpiresAt = account.TokenExpiresAt,
        LastOAuthAt = account.LastOAuthAt,
        OAuthClientId = account.OAuthClientId,
        OAuthClientSecret = account.OAuthClientSecret,
        OAuthScopes = account.OAuthScopes,
        OAuthRedirectPort = account.OAuthRedirectPort,
        ApiBaseUrl = account.ApiBaseUrl,
        GitBaseUrl = account.GitBaseUrl,
        IsDefault = account.IsDefault,
        CreatedAt = account.CreatedAt,
        UpdatedAt = account.UpdatedAt
    };


    private static long GetMetricMax(GitTrafficMetricDto metric)
    {
        var max = metric.Points.SelectMany(x => new[] { x.Count, x.Uniques }).DefaultIfEmpty(1).Max();
        return Math.Max(1, max);
    }

    private static string BuildBarStyle(long value, long max)
    {
        var percent = Math.Clamp(max <= 0 ? 0 : value * 100.0 / max, 0, 100);
        return $"width:{percent:0.##}%";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "-";
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.#} {units[unit]}";
    }

    private static string TrimMiddle(string? value, int max)
    {
        value ??= string.Empty;
        if (value.Length <= max || max < 8)
        {
            return value;
        }

        var left = Math.Max(3, max / 2 - 1);
        var right = Math.Max(3, max - left - 3);
        return value[..left] + "..." + value[^right..];
    }

    private static string NormalizeUiRelativePath(string? value)
    {
        var path = (value ?? string.Empty).Trim().Trim('"').Replace('\\', '/');
        if (string.IsNullOrWhiteSpace(path) || path.Contains("..", StringComparison.Ordinal))
        {
            return string.Empty;
        }

        return string.Join('/', path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    }

    private static string GetFileIcon(string? name)
    {
        var ext = Path.GetExtension(name ?? string.Empty).ToLowerInvariant();
        return ext switch
        {
            ".cs" or ".razor" or ".js" or ".ts" or ".json" or ".css" or ".scss" or ".html" or ".xml" or ".sql" or ".php" or ".py" => "fa-file-code",
            ".md" or ".txt" or ".yml" or ".yaml" or ".ini" or ".config" => "fa-file-lines",
            ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".svg" => "fa-file-image",
            ".zip" or ".rar" or ".7z" or ".gz" => "fa-file-zipper",
            ".mp3" or ".wav" or ".ogg" => "fa-file-audio",
            ".mp4" or ".webm" or ".mov" => "fa-file-video",
            _ => "fa-file"
        };
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (Hub is not null)
        {
            try
            {
                await Hub.DisposeAsync();
            }
            catch (OperationCanceledException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }
    }
}
