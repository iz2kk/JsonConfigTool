    private void ToggleGitPathSelection(string relativePath, ChangeEventArgs args)
    {
        var selected = args.Value is bool b ? b : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        if (selected)
        {
            SelectedGitPaths.Add(relativePath);
        }
        else
        {
            SelectedGitPaths.Remove(relativePath);
        }
    }

    private void ToggleSelectVisibleFiles(ChangeEventArgs args)
    {
        if (ExplorerData is null)
        {
            return;
        }

        var selected = args.Value is bool b ? b : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        foreach (var item in ExplorerData.Items.Where(x => x.CanStage))
        {
            if (selected)
            {
                SelectedGitPaths.Add(item.RelativePath);
            }
            else
            {
                SelectedGitPaths.Remove(item.RelativePath);
            }
        }
    }

