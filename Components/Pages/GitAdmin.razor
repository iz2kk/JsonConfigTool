    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "-";
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.#} {units[unit]}";
    }

    private static string TrimMiddle(string? value, int max)
    {
        value ??= string.Empty;
        if (value.Length <= max || max < 8)
        {
            return value;
        }

        var left = Math.Max(3, max / 2 - 1);
        var right = Math.Max(3, max - left - 3);
        return value[..left] + "..." + value[^right..];
    }

