@page "/dns"
@implements IAsyncDisposable
@inject ConfigSignalRHost SignalRHost
@inject ILocalExplorerService Explorer

<PageTitle>DNS Update</PageTitle>

<div class="ct-page ct-dns-page">
    <section class="ct-hero card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <div class="ct-eyebrow"><i class="fa-duotone fa-solid fa-globe-pointer"></i> DNS UPDATE</div>
                    <h1 class="ct-title mb-2">No-IP · Dynu · Cloudflare updater</h1>
                    <p class="ct-muted mb-0">Giữ mode nhập thủ công, thêm mode tự scan domain/zone/record rồi update A/AAAA. Log lưu trong <code>@(Dns?.DynamicFilePath ?? "startup/config/dynamic.json")</code>.</p>
                </div>
                <div class="d-flex flex-column align-items-lg-end gap-2">
                    <div class="ct-status-pill @(IsConnected ? "is-online" : "is-offline")">
                        <i class="fa-duotone fa-solid @(IsConnected ? "fa-circle-check" : "fa-plug-circle-xmark")"></i>
                        @(IsConnected ? "SignalR đã kết nối" : "SignalR chưa kết nối")
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@(Busy || string.IsNullOrWhiteSpace(Dns?.DynamicFilePath))" @onclick="OpenDnsConfigFolderAsync">
                        <i class="fa-duotone fa-solid fa-folder-open"></i> Open config folder DNS
                    </button>
                </div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert @(StatusIsError ? "alert-danger" : "alert-success") ct-alert shadow-sm" role="alert">
            <i class="fa-duotone fa-solid @(StatusIsError ? "fa-triangle-exclamation" : "fa-circle-info")"></i>
            <span>@StatusMessage</span>
            <button type="button" class="btn-close ms-auto" aria-label="Close" @onclick="ClearStatus"></button>
        </div>
    }

    <section class="card border-0 shadow-sm ct-panel">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h2 class="ct-section-title mb-1"><i class="fa-duotone fa-solid fa-network-wired"></i> IP public thật</h2>
                    <div class="ct-muted small">Lấy IP public rồi update bulk cho record A/AAAA đã bật.</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary" disabled="@Busy" @onclick="GetPublicIpAsync"><i class="fa-duotone fa-solid fa-location-crosshairs"></i> Lấy IP public</button>
                    <button type="button" class="btn btn-outline-info" disabled="@Busy" @onclick="() => ScanProviderAsync(ActiveProvider)"><i class="fa-duotone fa-solid fa-radar"></i> Scan tab hiện tại</button>
                    <button type="button" class="btn btn-success" disabled="@Busy" @onclick="() => BulkUpdateProviderAsync(ActiveProvider)"><i class="fa-duotone fa-solid fa-cloud-arrow-up"></i> Update tab hiện tại</button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="ReloadAsync"><i class="fa-duotone fa-solid fa-rotate"></i> Tải lại</button>
                </div>
            </div>

            <div class="ct-dns-ip-card mt-3">
                <div>
                    <div class="ct-muted small">IP public hiện tại</div>
                    <strong>@DisplayOr(Dns?.Config.PublicIp.LastIp, "Chưa lấy")</strong>
                </div>
                <div>
                    <div class="ct-muted small">Lần kiểm tra</div>
                    <strong>@FormatDate(Dns?.Config.PublicIp.CheckedAt)</strong>
                </div>
                <div>
                    <div class="ct-muted small">Nguồn</div>
                    <strong>@DisplayOr(Dns?.Config.PublicIp.Source, "-")</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm ct-panel">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="ct-section-title mb-1"><i class="fa-duotone fa-solid fa-clock-rotate-left"></i> Auto Update</h2>
                    <div class="ct-muted small">Chạy nền khi trang DNS đã mở SignalR host. Có thể chọn scan trước rồi update khi IP đổi.</div>
                </div>
                <button type="button" class="btn btn-sm btn-primary" disabled="@Busy" @onclick="SaveAutoUpdateAsync"><i class="fa-duotone fa-solid fa-floppy-disk"></i> Lưu Auto Update</button>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-3">
                    <div class="form-check form-switch ct-mini-box h-100">
                        <input class="form-check-input" type="checkbox" id="autoEnabled" @bind="AutoForm.Enabled" />
                        <label class="form-check-label fw-semibold" for="autoEnabled">Bật auto update</label>
                        <div class="ct-muted small mt-1">Tự lấy IP public và update record đã bật.</div>
                    </div>
                </div>
                <div class="col-12 col-lg-2">
                    <label class="form-label">Chu kỳ phút</label>
                    <input class="form-control" type="number" min="1" max="1440" @bind="AutoForm.IntervalMinutes" />
                </div>
                <div class="col-12 col-lg-3">
                    <div class="form-check form-switch ct-mini-box h-100">
                        <input class="form-check-input" type="checkbox" id="autoOnlyChange" @bind="AutoForm.UpdateOnlyWhenIpChanged" />
                        <label class="form-check-label fw-semibold" for="autoOnlyChange">Chỉ update khi IP đổi</label>
                        <div class="ct-muted small mt-1">Tránh spam API nếu IP không đổi.</div>
                    </div>
                </div>
                <div class="col-12 col-lg-3">
                    <div class="form-check form-switch ct-mini-box h-100">
                        <input class="form-check-input" type="checkbox" id="autoScanBefore" @bind="AutoForm.ScanBeforeUpdate" />
                        <label class="form-check-label fw-semibold" for="autoScanBefore">Scan trước khi update</label>
                        <div class="ct-muted small mt-1">Mode 2: tự scan domain/record rồi update.</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="ct-mini-box">
                        <strong>Trạng thái:</strong> @DisplayOr(Dns?.Config.AutoUpdate.LastStatus, "-") · @DisplayOr(Dns?.Config.AutoUpdate.LastMessage, "chưa chạy") · Lần chạy: @FormatDate(Dns?.Config.AutoUpdate.LastRunAt)
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm ct-panel">
        <div class="card-body p-3 p-lg-4">
            <ul class="nav nav-pills ct-sql-tabs mb-3" role="tablist">
                <li class="nav-item"><button type="button" class="nav-link @(ActiveProvider == "noip" ? "active" : null)" @onclick='() => SetProvider("noip")'><i class="fa-duotone fa-solid fa-cloud"></i> No-IP.org</button></li>
                <li class="nav-item"><button type="button" class="nav-link @(ActiveProvider == "dynu" ? "active" : null)" @onclick='() => SetProvider("dynu")'><i class="fa-duotone fa-solid fa-globe"></i> Dynu.com</button></li>
                <li class="nav-item"><button type="button" class="nav-link @(ActiveProvider == "cloudflare" ? "active" : null)" @onclick='() => SetProvider("cloudflare")'><i class="fa-duotone fa-solid fa-shield-cloud"></i> Cloudflare</button></li>
            </ul>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h2 class="ct-section-title mb-1"><i class="fa-duotone fa-solid @ProviderIcon(ActiveProvider)"></i> @ProviderTitle(ActiveProvider)</h2>
                    <div class="ct-muted small">Mode 1: nhập hostname thủ công. Mode 2: scan domain/zone/record từ API rồi update đúng A/AAAA.</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <div class="input-group input-group-sm ct-dns-search-box">
                        <span class="input-group-text"><i class="fa-duotone fa-solid fa-magnifying-glass"></i></span>
                        <input class="form-control" placeholder="Tìm tài khoản/domain/record/log..." value="@SearchText" @oninput="OnSearchInput" />
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-info" disabled="@Busy" @onclick="() => ScanProviderAsync(ActiveProvider)"><i class="fa-duotone fa-solid fa-radar"></i> Scan provider</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="OpenCreateAccountModal"><i class="fa-duotone fa-solid fa-user-plus"></i> Thêm tài khoản</button>
                </div>
            </div>

            <div class="ct-dns-account-grid">
                @if (GetAccounts().Count == 0)
                {
                    <div class="ct-empty-inline"><i class="fa-duotone fa-solid fa-inbox"></i> Chưa có tài khoản @ProviderTitle(ActiveProvider).</div>
                }

                @foreach (var account in GetAccounts())
                {
                    <div class="ct-dns-account-card" @key="account.Id">
                        <div class="ct-dns-account-head">
                            <div>
                                <strong><i class="fa-duotone fa-solid @ProviderIcon(account.Provider)"></i> @account.Name</strong>
                                <div class="ct-muted small">@AccountSubTitle(account) · @account.Domains.Count record</div>
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <span class="badge @(account.Enabled ? "text-bg-success" : "text-bg-secondary")">@(account.Enabled ? "Enabled" : "Disabled")</span>
                                <span class="badge text-bg-light border">@ProviderTitle(account.Provider)</span>
                                <span class="badge text-bg-light border">@AuthModeTitle(account)</span>
                            </div>
                        </div>

                        <div class="ct-dns-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditAccountModal(account)"><i class="fa-duotone fa-solid fa-pen"></i> Sửa</button>
                            @if (NormalizeProvider(account.Provider) == "dynu" && NormalizeAuthMode(account) == "oauth2")
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@Busy" @onclick="() => AuthorizeAccountAsync(account)"><i class="fa-duotone fa-solid fa-key"></i> OAuth</button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-info" disabled="@Busy" @onclick="() => ScanAccountAsync(account)"><i class="fa-duotone fa-solid fa-radar"></i> Scan</button>
                            <button type="button" class="btn btn-sm btn-outline-success" disabled="@Busy" @onclick="() => BulkUpdateAccountAsync(account)"><i class="fa-duotone fa-solid fa-cloud-arrow-up"></i> Update account</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenCreateDomainModal(account)"><i class="fa-duotone fa-solid fa-link"></i> Thêm thủ công</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteAccountModal(account)"><i class="fa-duotone fa-solid fa-trash-can"></i> Xóa</button>
                        </div>

                        <div class="ct-dns-domain-list">
                            @if (account.Domains.Count == 0)
                            {
                                <div class="ct-empty-inline small"><i class="fa-duotone fa-solid fa-circle-info"></i> Chưa có record trong tài khoản này. Bấm Scan hoặc thêm thủ công.</div>
                            }
                            @foreach (var domain in account.Domains.Where(MatchesSearch).OrderBy(x => x.ZoneName).ThenBy(x => x.Hostname).ThenBy(x => x.RecordType))
                            {
                                <div class="ct-dns-domain-row" @key="domain.Id">
                                    <div>
                                        <strong><i class="fa-duotone fa-solid fa-globe-pointer"></i> @domain.Hostname <span class="badge text-bg-light border">@DisplayOr(domain.RecordType, "A")</span></strong>
                                        <div class="ct-muted small">IP: @DisplayOr(domain.LastIp, "-") · Update: @FormatDate(domain.LastUpdatedAt) · Scan: @FormatDate(domain.LastScannedAt)</div>
                                        <div class="ct-muted small">Zone: @DisplayOr(domain.ZoneName, "-") · RecordId: @ShortId(domain.RecordId) · Source: @DisplayOr(domain.ScanSource, "manual")</div>
                                        <div class="small @DomainStatusCss(domain)">@domain.LastStatus @domain.LastMessage</div>
                                    </div>
                                    <div class="ct-dns-domain-actions">
                                        <span class="badge @(domain.Enabled ? "text-bg-success" : "text-bg-secondary")">@(domain.Enabled ? "ON" : "OFF")</span>
                                        <button type="button" class="btn btn-sm btn-outline-success" disabled="@Busy" @onclick="() => UpdateDomainAsync(account, domain)"><i class="fa-duotone fa-solid fa-rotate"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditDomainModal(account, domain)"><i class="fa-duotone fa-solid fa-pen"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteDomainModal(account, domain)"><i class="fa-duotone fa-solid fa-trash-can"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm ct-panel">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div>
                    <h2 class="ct-section-title mb-1"><i class="fa-duotone fa-solid fa-list-timeline"></i> Log update</h2>
                    <div class="ct-muted small">Hiển thị từ dynamic.json, tối đa 500 log mới nhất.</div>
                </div>
                <span class="badge text-bg-light border">@(FilteredLogs.Count) log</span>
            </div>
            <div class="ct-dns-log-table table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Thời gian</th><th>Provider</th><th>Tài khoản</th><th>Domain</th><th>Type</th><th>IP</th><th>Kết quả</th></tr></thead>
                    <tbody>
                    @foreach (var log in FilteredLogs.Take(120))
                    {
                        <tr>
                            <td>@FormatDate(log.UpdatedAt)</td>
                            <td><span class="badge text-bg-light border">@ProviderTitle(log.Provider)</span></td>
                            <td>@log.AccountName</td>
                            <td>@log.Hostname</td>
                            <td>@DisplayOr(log.RecordType, "-")</td>
                            <td><code>@log.Ip</code></td>
                            <td><span class="badge @(log.Success ? "text-bg-success" : "text-bg-danger")">@(log.Success ? "OK" : "FAIL")</span> <span class="small">@log.Message</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@if (ShowAccountModal)
{
    <div class="modal fade show ct-modal" tabindex="-1" style="display:block;" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-xl ct-resizable-modal">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-duotone fa-solid fa-user-gear"></i> @AccountModalTitle</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAccountModal"></button>
                </div>
                <div class="modal-body">
                    @if (AccountDeleteMode)
                    {
                        <div class="alert alert-danger">Xóa tài khoản <strong>@AccountForm.Name</strong> và toàn bộ record bên trong?</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-12 col-lg-4">
                                <label class="form-label">Provider</label>
                                <select class="form-select" @bind="AccountForm.Provider">
                                    <option value="noip">No-IP.org</option>
                                    <option value="dynu">Dynu.com</option>
                                    <option value="cloudflare">Cloudflare</option>
                                </select>
                            </div>
                            <div class="col-12 col-lg-4">
                                <label class="form-label">Auth mode</label>
                                <select class="form-select" @bind="AccountForm.AuthMode">
                                    <option value="basic">Username/password hoặc DDNS key</option>
                                    <option value="api-key">API Key</option>
                                    <option value="oauth2">OAuth2 client_id/secret</option>
                                    <option value="api-token">API Token</option>
                                </select>
                            </div>
                            <div class="col-12 col-lg-4 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="accountEnabled" @bind="AccountForm.Enabled" />
                                    <label class="form-check-label" for="accountEnabled">Bật account</label>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Tên hiển thị</label>
                                <input class="form-control" @bind="AccountForm.Name" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">API Key / API Token</label>
                                <input class="form-control" autocomplete="off" placeholder="Cloudflare token, Dynu API-Key, No-IP sk_..." @bind="AccountForm.ApiKey" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Username / DDNS ID</label>
                                <input class="form-control" autocomplete="username" @bind="AccountForm.Username" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Password / DDNS key</label>
                                <input class="form-control" type="password" autocomplete="current-password" @bind="AccountForm.Password" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Dynu OAuth client_id</label>
                                <input class="form-control" autocomplete="off" @bind="AccountForm.OAuthClientId" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Dynu OAuth secret</label>
                                <input class="form-control" type="password" autocomplete="off" @bind="AccountForm.OAuthSecret" />
                            </div>
                            <div class="col-12">
                                <div class="ct-mini-box">
                                    <div class="fw-semibold mb-1"><i class="fa-duotone fa-solid fa-circle-info"></i> Gợi ý</div>
                                    <div class="small">Cloudflare dùng API Token. Dynu có API-Key hoặc OAuth2. No-IP scan dùng API Key, update DDNS dùng username/password hoặc DDNS key.</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Ghi chú</label>
                                <textarea class="form-control" rows="3" @bind="AccountForm.Note"></textarea>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="CloseAccountModal">Hủy</button>
                    <button type="button" class="btn @(AccountDeleteMode ? "btn-danger" : "btn-primary")" disabled="@Busy" @onclick="SaveAccountModalAsync">
                        <i class="fa-duotone fa-solid @(AccountDeleteMode ? "fa-trash-can" : "fa-floppy-disk")"></i> @(AccountDeleteMode ? "Xóa" : "Lưu")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (ShowDomainModal)
{
    <div class="modal fade show ct-modal" tabindex="-1" style="display:block;" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-xl ct-resizable-modal">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa-duotone fa-solid fa-globe-pointer"></i> @DomainModalTitle</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDomainModal"></button>
                </div>
                <div class="modal-body">
                    @if (DomainDeleteMode)
                    {
                        <div class="alert alert-danger">Xóa record <strong>@DomainForm.Hostname</strong> khỏi tài khoản <strong>@(DomainAccount?.Name)</strong>?</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-12 col-lg-5">
                                <label class="form-label">Domain / hostname</label>
                                <input class="form-control form-control-lg" placeholder="vd: home.example.ddns.net" @bind="DomainForm.Hostname" />
                            </div>
                            <div class="col-12 col-lg-2">
                                <label class="form-label">Type</label>
                                <select class="form-select form-select-lg" @bind="DomainForm.RecordType">
                                    <option value="A">A</option>
                                    <option value="AAAA">AAAA</option>
                                </select>
                            </div>
                            <div class="col-12 col-lg-5 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="domainEnabled" @bind="DomainForm.Enabled" />
                                    <label class="form-check-label" for="domainEnabled">Bật update record này</label>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Zone name</label>
                                <input class="form-control" placeholder="Cloudflare/no-ip zone, có thể bỏ trống nếu nhập thủ công" @bind="DomainForm.ZoneName" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Record name</label>
                                <input class="form-control" placeholder="Tên record từ API scan" @bind="DomainForm.RecordName" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Zone ID</label>
                                <input class="form-control" @bind="DomainForm.ZoneId" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">Record ID</label>
                                <input class="form-control" @bind="DomainForm.RecordId" />
                            </div>
                            <div class="col-12">
                                <div class="ct-mini-box">
                                    <div class="fw-semibold mb-1"><i class="fa-duotone fa-solid fa-circle-info"></i> Tài khoản</div>
                                    <div>@(DomainAccount?.Name) · @ProviderTitle(DomainAccount?.Provider ?? ActiveProvider) · @AccountSubTitle(DomainAccount)</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="CloseDomainModal">Hủy</button>
                    <button type="button" class="btn @(DomainDeleteMode ? "btn-danger" : "btn-primary")" disabled="@Busy" @onclick="SaveDomainModalAsync">
                        <i class="fa-duotone fa-solid @(DomainDeleteMode ? "fa-trash-can" : "fa-floppy-disk")"></i> @(DomainDeleteMode ? "Xóa" : "Lưu")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private HubConnection? Hub;
    private IDisposable? DnsChangedSubscription;
    private IDisposable? DnsSoftErrorSubscription;
    private DynamicDnsResponseDto? Dns;
    private DynamicDnsAutoUpdateDto AutoForm = new();
    private string ActiveProvider = "noip";
    private string SearchText = string.Empty;
    private string? StatusMessage;
    private bool StatusIsError;
    private bool Busy;

    private bool ShowAccountModal;
    private bool AccountDeleteMode;
    private string AccountModalTitle = string.Empty;
    private DynamicDnsAccountDto AccountForm = new();

    private bool ShowDomainModal;
    private bool DomainDeleteMode;
    private string DomainModalTitle = string.Empty;
    private DynamicDnsAccountDto? DomainAccount;
    private DynamicDnsDomainDto DomainForm = new();

    private bool IsConnected => Hub?.State == HubConnectionState.Connected;

    private List<DynamicDnsLogDto> FilteredLogs => (Dns?.Config.Logs ?? [])
        .Where(x => string.Equals(NormalizeProvider(x.Provider), ActiveProvider, StringComparison.OrdinalIgnoreCase))
        .Where(MatchesSearch)
        .OrderByDescending(x => x.UpdatedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await InitializeSignalRAsync();
        await ReloadAsync();
    }

    private async Task InitializeSignalRAsync()
    {
        Busy = true;
        try
        {
            await SignalRHost.EnsureStartedAsync();
            Hub = new HubConnectionBuilder()
                .WithUrl(SignalRHost.HubUrl)
                .WithAutomaticReconnect()
                .Build();

            DnsChangedSubscription = Hub.On<DynamicDnsResponseDto, string>("DynamicDnsChanged", (snapshot, message) =>
                InvokeAsync(() =>
                {
                    Dns = snapshot;
                    AutoForm = CloneAuto(snapshot.Config.AutoUpdate);
                    StatusOk(message);
                    StateHasChanged();
                }));

            DnsSoftErrorSubscription = Hub.On<string>("DynamicDnsSoftError", message =>
                InvokeAsync(() =>
                {
                    StatusError(message);
                    StateHasChanged();
                }));

            await Hub.StartAsync();
        }
        catch (Exception ex)
        {
            StatusError("Không khởi động được SignalR local server: " + ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        if (Hub is null) return;
