    private static string NormalizeProvider(string? provider)
    {
        provider = (provider ?? string.Empty).Trim().ToLowerInvariant();
        return provider switch
        {
            "dynu" or "dynu.com" => "dynu",
            "cloudflare" or "cf" => "cloudflare",
            _ => "noip"
        };
    }

    private static string NormalizeAuthMode(DynamicDnsAccountDto? account)
    {
        if (account is null) return "basic";
        var provider = NormalizeProvider(account.Provider);
        var mode = (account.AuthMode ?? string.Empty).Trim().ToLowerInvariant();
        return provider switch
        {
            "cloudflare" => "api-token",
            "dynu" when mode is "oauth" or "oauth2" => "oauth2",
            "dynu" when mode is "apikey" or "api-key" => "api-key",
            "noip" when mode is "apikey" or "api-key" => "api-key",
            _ => "basic"
        };
    }

    private static string DefaultAuthMode(string provider) => NormalizeProvider(provider) switch
    {
        "dynu" => "oauth2",
        "cloudflare" => "api-token",
        _ => "basic"
    };

    private static string ProviderTitle(string provider) => NormalizeProvider(provider) switch
    {
        "dynu" => "Dynu.com",
        "cloudflare" => "Cloudflare",
        _ => "No-IP.org"
    };

    private static string ProviderIcon(string provider) => NormalizeProvider(provider) switch
    {
        "dynu" => "fa-globe",
        "cloudflare" => "fa-shield-cloud",
        _ => "fa-cloud"
    };

    private static string AuthModeTitle(DynamicDnsAccountDto account) => NormalizeAuthMode(account) switch
    {
        "oauth2" => "OAuth2",
        "api-key" => "API Key",
        "api-token" => "API Token",
        _ => "Basic/DDNS"
    };

    private static string AccountSubTitle(DynamicDnsAccountDto? account)
    {
        if (account is null) return "-";
        var provider = NormalizeProvider(account.Provider);
        if (provider == "cloudflare") return string.IsNullOrWhiteSpace(account.ApiKey) ? "Chưa nhập API token" : "API token đã nhập";
        if (provider == "dynu" && NormalizeAuthMode(account) == "oauth2") return string.IsNullOrWhiteSpace(account.AccessToken) ? "OAuth chưa lấy token" : "OAuth token hết hạn: " + FormatDate(account.AccessTokenExpiresAt);
        if (!string.IsNullOrWhiteSpace(account.Username)) return account.Username;
        if (!string.IsNullOrWhiteSpace(account.ApiKey)) return "API key đã nhập";
        return "Chưa nhập auth";
    }

    private static string DomainStatusCss(DynamicDnsDomainDto domain)
        => (domain.LastStatus.Contains("OK", StringComparison.OrdinalIgnoreCase) || domain.LastStatus.Contains("200", StringComparison.OrdinalIgnoreCase) || domain.LastMessage.Contains("good", StringComparison.OrdinalIgnoreCase) || domain.LastMessage.Contains("nochg", StringComparison.OrdinalIgnoreCase) || domain.LastMessage.Contains("success", StringComparison.OrdinalIgnoreCase))
            ? "text-success"
            : "text-muted";

    private static string FormatDate(DateTimeOffset? value) => value is null ? "-" : value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    private static string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    private static string DisplayOr(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string ShortId(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : (value.Length <= 10 ? value : value[..10] + "…");

    private static DynamicDnsAutoUpdateDto CloneAuto(DynamicDnsAutoUpdateDto? settings) => new()
    {
        Enabled = settings?.Enabled ?? false,
        IntervalMinutes = NormalizeInterval(settings?.IntervalMinutes),
        UpdateOnlyWhenIpChanged = settings?.UpdateOnlyWhenIpChanged ?? true,
        ScanBeforeUpdate = settings?.ScanBeforeUpdate ?? false,
        LastRunAt = settings?.LastRunAt,
        LastIp = settings?.LastIp ?? string.Empty,
        LastStatus = settings?.LastStatus ?? string.Empty,
        LastMessage = settings?.LastMessage ?? string.Empty
    };

    private static int NormalizeInterval(int? value) => value is null or <= 0 ? 10 : Math.Clamp(value.Value, 1, 1440);

    private static DynamicDnsAccountDto CloneAccount(DynamicDnsAccountDto account, bool includeDomains) => new()
    {
        Id = account.Id,
        Provider = NormalizeProvider(account.Provider),
        Name = account.Name,
        AuthMode = NormalizeAuthMode(account),
        Username = account.Username,
        Password = account.Password,
        ApiKey = account.ApiKey,
        OAuthClientId = account.OAuthClientId,
        OAuthSecret = account.OAuthSecret,
        AccessToken = account.AccessToken,
        AccessTokenExpiresAt = account.AccessTokenExpiresAt,
        Enabled = account.Enabled,
        Note = account.Note,
        CreatedAt = account.CreatedAt,
        UpdatedAt = account.UpdatedAt,
        Domains = includeDomains ? account.Domains.Select(CloneDomain).ToList() : []
    };

    private static DynamicDnsDomainDto CloneDomain(DynamicDnsDomainDto domain) => new()
    {
        Id = domain.Id,
        Hostname = domain.Hostname,
        ZoneName = domain.ZoneName,
        ZoneId = domain.ZoneId,
        RecordId = domain.RecordId,
        RecordName = domain.RecordName,
        RecordType = string.IsNullOrWhiteSpace(domain.RecordType) ? "A" : domain.RecordType,
        Ttl = domain.Ttl,
        Proxied = domain.Proxied,
        ScanSource = domain.ScanSource,
        Enabled = domain.Enabled,
        LastIp = domain.LastIp,
        LastStatus = domain.LastStatus,
        LastMessage = domain.LastMessage,
        LastUpdatedAt = domain.LastUpdatedAt,
        LastScannedAt = domain.LastScannedAt,
        UpdateCount = domain.UpdateCount
    };

    public async ValueTask DisposeAsync()
    {
        DnsChangedSubscription?.Dispose();
        DnsSoftErrorSubscription?.Dispose();
        if (Hub is not null)
        {
            await Hub.DisposeAsync();
        }
    }
