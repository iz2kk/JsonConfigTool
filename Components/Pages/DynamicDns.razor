    private void SetProvider(string provider) => ActiveProvider = NormalizeProvider(provider);

    private List<DynamicDnsAccountDto> GetAccounts() => (Dns?.Config.Accounts ?? [])
        .Where(x => string.Equals(NormalizeProvider(x.Provider), ActiveProvider, StringComparison.OrdinalIgnoreCase))
        .Where(MatchesSearch)
        .OrderBy(x => x.Name)
        .ToList();

    private bool MatchesSearch(DynamicDnsAccountDto account)
    {
        if (string.IsNullOrWhiteSpace(SearchText)) return true;
        var q = SearchText.Trim();
        return Contains(account.Name, q)
            || Contains(account.Username, q)
            || Contains(account.Note, q)
            || Contains(account.ApiKey, q)
            || account.Domains.Any(x => Contains(x.Hostname, q) || Contains(x.ZoneName, q) || Contains(x.RecordType, q) || Contains(x.LastIp, q) || Contains(x.LastMessage, q));
    }

    private bool MatchesSearch(DynamicDnsDomainDto domain)
    {
        if (string.IsNullOrWhiteSpace(SearchText)) return true;
        var q = SearchText.Trim();
        return Contains(domain.Hostname, q) || Contains(domain.ZoneName, q) || Contains(domain.RecordName, q) || Contains(domain.RecordType, q) || Contains(domain.LastIp, q) || Contains(domain.LastMessage, q) || Contains(domain.LastStatus, q);
    }

    private bool MatchesSearch(DynamicDnsLogDto log)
    {
        if (string.IsNullOrWhiteSpace(SearchText)) return true;
        var q = SearchText.Trim();
        return Contains(log.AccountName, q) || Contains(log.Hostname, q) || Contains(log.RecordType, q) || Contains(log.Ip, q) || Contains(log.Message, q) || Contains(log.Status, q);
    }

    private static bool Contains(string? value, string query) => (value ?? string.Empty).Contains(query, StringComparison.OrdinalIgnoreCase);

