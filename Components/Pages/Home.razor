        _ => "fa-input-text"
    };

    private static string GetKindCssClass(string? kind) => "is-kind-" + NormalizeKind(kind);

    private static string GetPreviewDepthStyle(int depth) => "--ct-depth:" + Math.Clamp(depth, 0, 8).ToString(System.Globalization.CultureInfo.InvariantCulture) + ";";

    private static bool CanPreviewJsonValue(string? kind, string? value)
    {
        var normalizedKind = NormalizeKind(kind);
        if (normalizedKind is not ("json" or "object" or "array") || string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        try
        {
            _ = System.Text.Json.Nodes.JsonNode.Parse(value);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static List<JsonPreviewRow> BuildJsonPreviewRows(string? json, int maxDepth = 5, int maxRows = 80)
    {
        var rows = new List<JsonPreviewRow>();
        if (string.IsNullOrWhiteSpace(json))
        {
            return rows;
        }

        try
        {
            var root = System.Text.Json.Nodes.JsonNode.Parse(json);
            AddPreviewNode(rows, "root", root, 0, maxDepth, maxRows);
        }
        catch
        {
            return rows;
        }

        return rows;
    }

    private static void AddPreviewNode(List<JsonPreviewRow> rows, string name, System.Text.Json.Nodes.JsonNode? node, int depth, int maxDepth, int maxRows)
    {
        if (rows.Count >= maxRows)
        {
            return;
        }

        var kind = GetEditorKindFromNode(node);
        var isContainer = node is System.Text.Json.Nodes.JsonObject or System.Text.Json.Nodes.JsonArray;
        rows.Add(new JsonPreviewRow
        {
            Depth = depth,
            Name = name,
            Kind = kind,
            Value = GetPreviewValue(node),
            IsContainer = isContainer
        });

        if (!isContainer || depth >= maxDepth || rows.Count >= maxRows)
        {
            return;
        }

        if (node is System.Text.Json.Nodes.JsonObject obj)
        {
            foreach (var property in obj)
            {
                AddPreviewNode(rows, property.Key, property.Value, depth + 1, maxDepth, maxRows);
                if (rows.Count >= maxRows)
                {
                    return;
                }
            }
        }
        else if (node is System.Text.Json.Nodes.JsonArray array)
        {
            for (var i = 0; i < array.Count; i++)
            {
                AddPreviewNode(rows, "[" + i.ToString(System.Globalization.CultureInfo.InvariantCulture) + "]", array[i], depth + 1, maxDepth, maxRows);
                if (rows.Count >= maxRows)
                {
                    return;
                }
            }
        }
    }

    private static string GetPreviewValue(System.Text.Json.Nodes.JsonNode? node)
    {
        if (node is null)
        {
            return "null";
        }

        if (node is System.Text.Json.Nodes.JsonObject obj)
        {
            return "{ " + obj.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + " field }";
        }

        if (node is System.Text.Json.Nodes.JsonArray array)
        {
            return "[ " + array.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + " item ]";
        }

        if (node is System.Text.Json.Nodes.JsonValue value)
        {
            if (value.TryGetValue<string>(out var text))
            {
                return ShortPreviewValue(text);
            }

            if (value.TryGetValue<bool>(out var boolValue))
            {
                return boolValue ? "true" : "false";
            }
        }

        return ShortPreviewValue(node.ToJsonString());
    }

    private static string ShortPreviewValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        value = value.ReplaceLineEndings(" ").Trim();
        return value.Length > 72 ? value[..72] + "…" : value;
    }


    private JsonEditorNode EnsureTreeRoot(EditorFieldState field)
    {
        var kind = NormalizeKind(field.Kind);
        if (field.TreeRoot is null || !TreeRootMatchesFieldKind(field.TreeRoot, kind))
        {
            var initialValue = kind switch
            {
                "array" => string.IsNullOrWhiteSpace(field.Value) ? "[]" : field.Value,
                "object" => string.IsNullOrWhiteSpace(field.Value) ? "{}" : field.Value,
                "json" => string.IsNullOrWhiteSpace(field.Value) ? "{}" : field.Value,
                _ => field.Value
            };
            field.TreeRoot = JsonEditorNodeFactory.CreateRootFromEditText(field.Name, kind, initialValue);
        }

        return field.TreeRoot;
    }

    private static bool TreeRootMatchesFieldKind(JsonEditorNode root, string fieldKind)
    {
        var rootKind = JsonEditorNodeFactory.NormalizeKind(root.Kind);
        return fieldKind switch
        {
            "array" => rootKind == "array",
            "object" => rootKind == "object",
            "json" => true,
            _ => false
        };
    }

    private string? BuildEditorFieldValue(EditorFieldState field, string kind)
    {
        if (kind == "null")
        {
            return null;
        }

        if (kind is "array" or "object" or "json")
        {
            var root = EnsureTreeRoot(field);
            var json = JsonEditorNodeFactory.BuildJsonText(root);
            field.Value = json;
            return json;
        }

        return field.Value;
    }

    private string BuildTreeJsonSafe(EditorFieldState field)
    {
        try
        {
            var root = EnsureTreeRoot(field);
            var json = JsonEditorNodeFactory.BuildJsonText(root);
            field.Value = json;
            return json;
        }
        catch
        {
            return field.Value ?? string.Empty;
        }
    }

    private void ReplaceTreeRootFromRaw(EditorFieldState field, string? rawJson)
    {
        var kind = NormalizeKind(field.Kind);
        field.Value = rawJson ?? string.Empty;
        field.TreeRoot = JsonEditorNodeFactory.CreateRootFromEditText(field.Name, kind, field.Value);
    }

    private async Task SaveEditorAsync()
    {
        if (Hub is null || Editor is null || SelectedFile is null || SelectedTable is null)
        {
            return;
        }

        Busy = true;
        try
        {
            var duplicatedField = Editor.Fields
                .Where(x => !string.IsNullOrWhiteSpace(x.Name))
                .GroupBy(x => x.Name.Trim(), StringComparer.OrdinalIgnoreCase)
                .FirstOrDefault(x => x.Count() > 1);
            if (duplicatedField is not null)
            {
                StatusError($"Field/key '{duplicatedField.Key}' đang bị trùng trong form.");
                return;
            }

            var request = new JsonRowWriteRequest
            {
                FileName = SelectedFile.FileName,
                TableName = SelectedTable.Name,
                RowIndex = Editor.RowIndex,
                RowKey = Editor.RowKey,
                IdField = string.IsNullOrWhiteSpace(Editor.IdField) ? SelectedTable.IdField : Editor.IdField,
                AutoMergeWithLatest = true,
                ExpectedFileVersion = RowsPage?.FileVersion ?? SelectedFile.FileVersion,
                OriginalCells = Editor.OriginalCells.Select(CloneCell).ToList(),
                Cells = Editor.Fields
                    .Where(x => !string.IsNullOrWhiteSpace(x.Name))
                    .Select(x =>
                    {
                        var kind = NormalizeKind(x.Kind);
                        return new JsonCellDto
                        {
                            Name = x.Name.Trim(),
                            OriginalName = x.OriginalName,
                            Kind = kind,
                            Value = BuildEditorFieldValue(x, kind),
                            IsKey = x.IsKey
                        };
                    })
                    .ToList(),
                DeletedFieldNames = Editor.DeletedFieldNames.Distinct(StringComparer.OrdinalIgnoreCase).ToList()
            };

            var result = Editor.IsCreate
                ? await Hub.InvokeAsync<JsonCrudResultDto>("CreateRowAsync", request, SearchText, CurrentPage, PageSize)
                : await Hub.InvokeAsync<JsonCrudResultDto>("UpdateRowAsync", request, SearchText, CurrentPage, PageSize);

            if (result.Success)
            {
                RowsPage = result.Page ?? RowsPage;
                CurrentPage = RowsPage?.Page ?? CurrentPage;
                Editor = null;
                StatusOk(BuildCrudStatusMessage(result));
                await RefreshFilesOnlyAsync();
                await LoadRowsAsync();
            }
            else
            {
                StatusError(result.Message);
            }
        }
        catch (Exception ex)
        {
            StatusError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private void CloseEditor() => Editor = null;

    private void OpenDeleteModal(JsonRowDto row) => DeleteTarget = row;

    private void CloseDeleteModal() => DeleteTarget = null;

    private async Task DeleteRowAsync()
    {
        if (Hub is null || DeleteTarget is null || SelectedFile is null || SelectedTable is null)
        {
            return;
        }

        Busy = true;
        try
        {
            var request = new JsonRowDeleteRequest
            {
                FileName = SelectedFile.FileName,
                TableName = SelectedTable.Name,
                RowIndex = DeleteTarget.RowIndex,
                RowKey = DeleteTarget.RowKey,
                IdField = SelectedTable.IdField,
                ExpectedFileVersion = RowsPage?.FileVersion ?? SelectedFile.FileVersion,
                OriginalCells = DeleteTarget.Cells.Select(CloneCell).ToList()
            };

            var result = await Hub.InvokeAsync<JsonCrudResultDto>("DeleteRowAsync", request, SearchText, CurrentPage, PageSize);
            if (result.Success)
            {
                RowsPage = result.Page ?? RowsPage;
                CurrentPage = RowsPage?.Page ?? CurrentPage;
                DeleteTarget = null;
                StatusOk(BuildCrudStatusMessage(result));
                await RefreshFilesOnlyAsync();
                await LoadRowsAsync();
            }
            else
            {
                StatusError(result.Message);
            }
        }
        catch (Exception ex)
        {
            StatusError(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ApplyRealtimeFilesChangeAsync(ConfigExternalChangeDto change)
    {
        LastRealtimeFileChangeAt = change.ChangedAt;

        if (!change.Folder.IsValid)
        {
            Files.Clear();
            SelectedFile = null;
            SelectedTable = null;
            Tables.Clear();
            RowsPage = null;
            StatusError(change.Message);
            StateHasChanged();
            return;
        }

        Files = change.Files;
        if (SelectedFile is not null)
        {
            var updatedSelectedFile = Files.FirstOrDefault(x => string.Equals(x.FileName, SelectedFile.FileName, StringComparison.OrdinalIgnoreCase));
            if (updatedSelectedFile is not null)
            {
                SelectedFile = updatedSelectedFile;
            }
        }

        var selectedFileWasChanged = SelectedFile is not null
            && (string.IsNullOrWhiteSpace(change.FileName)
                || string.Equals(change.FileName, SelectedFile.FileName, StringComparison.OrdinalIgnoreCase));

        if (selectedFileWasChanged)
        {
            if (Editor is not null)
            {
                if (IsEditorDirty())
                {
                    await RefreshFilesOnlyAsync();
                    StatusOk(change.Message + " Form đang sửa sẽ giữ input hiện tại; khi lưu tool auto-merge vào JSON mới nhất và bỏ qua field Unity vừa đổi.");
                }
                else
                {
                    Editor = null;
                    await RefreshFilesOnlyAsync();
                    await LoadRowsAsync();
                    StatusOk(change.Message + " Form chưa sửa nên đã reload theo Unity.");
                }
            }
            else if (DeleteTarget is not null)
            {
                DeleteTarget = null;
                await RefreshFilesOnlyAsync();
                await LoadRowsAsync();
                StatusOk(change.Message + " Đã đóng popup xóa vì dòng có thể đã đổi trong Unity.");
            }
            else
            {
                await RefreshFilesOnlyAsync();
                await LoadRowsAsync();
                StatusOk(change.Message);
            }
        }
        else if (!string.IsNullOrWhiteSpace(change.Message))
        {
            StatusOk(change.Message);
        }

        StateHasChanged();
    }

    private static JsonCellDto CloneCell(JsonCellDto cell)
        => new()
        {
            Name = cell.Name,
            OriginalName = cell.OriginalName,
            Kind = cell.Kind,
            Value = cell.Value,
            IsKey = cell.IsKey
        };

    private bool IsEditorDirty()
    {
        if (Editor is null || Editor.IsCreate)
        {
            return Editor?.Fields.Any(x => !string.IsNullOrWhiteSpace(x.Value) || !string.Equals(x.Name, "newField", StringComparison.OrdinalIgnoreCase)) == true;
        }

        if (Editor.DeletedFieldNames.Count > 0)
        {
            return true;
        }

        foreach (var field in Editor.Fields)
        {
            if (!string.Equals(field.Name?.Trim(), field.OriginalName?.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            if (!string.Equals(NormalizeKind(field.Kind), NormalizeKind(field.OriginalKind), StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            var kind = NormalizeKind(field.Kind);
            var currentValue = BuildEditorFieldValue(field, kind);
            if (!string.Equals(currentValue ?? string.Empty, field.OriginalValue ?? string.Empty, StringComparison.Ordinal))
            {
                return true;
            }
        }

        return false;
    }

    private static string BuildCrudStatusMessage(JsonCrudResultDto result)
    {
        if (result.Conflicts.Count == 0)
        {
            return result.Message;
        }

        var details = string.Join("; ", result.Conflicts.Take(3));
        if (result.Conflicts.Count > 3)
        {
            details += $"; +{result.Conflicts.Count - 3} field khác";
        }

        return result.Message + " " + details;
    }

    private async Task RefreshFilesOnlyAsync()
    {
        if (Hub is null)
        {
            return;
        }

        Files = await Hub.InvokeAsync<List<JsonConfigFileDto>>("GetFilesAsync");
        if (SelectedFile is not null)
        {
            SelectedFile = Files.FirstOrDefault(x => x.FileName == SelectedFile.FileName) ?? SelectedFile;
        }

        if (SelectedFile is not null)
        {
            Tables = await Hub.InvokeAsync<List<JsonTableDto>>("GetTablesAsync", SelectedFile.FileName);
            await RefreshKeySuggestionsAsync();
            if (SelectedTable is not null)
            {
                SelectedTable = Tables.FirstOrDefault(x => x.Name == SelectedTable.Name) ?? SelectedTable;
            }
        }
    }

    private string MakeUniqueEditorFieldName(string prefix)
    {
        if (Editor is null)
        {
            return prefix;
        }

        var existing = Editor.Fields.Select(x => x.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!existing.Contains(prefix))
        {
            return prefix;
        }

        for (var i = 2; i < 10_000; i++)
        {
            var candidate = prefix + i.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (!existing.Contains(candidate))
            {
                return candidate;
            }
        }

        return prefix + Guid.NewGuid().ToString("N")[..6];
    }

    private static string NormalizeKind(string? kind)
    {
        return kind?.Trim().ToLowerInvariant() switch
        {
            "boolean" => "bool",
            "object" => "object",
            "array" => "array",
            "json" => "json",
            "number" => "number",
            "null" => "null",
            "bool" => "bool",
            _ => "string"
        };
    }

    private static string DefaultValue(string? kind) => NormalizeKind(kind) switch
    {
        "number" => "0",
        "bool" => "false",
        "object" => "{}",
        "array" => "[]",
        "json" => "{}",
        "null" => string.Empty,
        _ => string.Empty
    };

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double value = bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }

    private static string ShortValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        value = value.ReplaceLineEndings(" ").Trim();
        return value.Length > 120 ? value[..120] + "…" : value;
    }

    private void StatusOk(string message)
    {
        StatusIsError = false;
        StatusMessage = message;
    }

    private void StatusError(string message)
    {
        StatusIsError = true;
        StatusMessage = message;
    }

    private void ClearStatus()
    {
        StatusMessage = null;
        StatusIsError = false;
    }

    public async ValueTask DisposeAsync()
    {
        SearchDebounce?.Cancel();
        SearchDebounce?.Dispose();
        ChangedSubscription?.Dispose();
        FilesChangedSubscription?.Dispose();
        if (Hub is not null)
        {
            await Hub.DisposeAsync();
        }
    }

